{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "lib": [
      "ES2022"
    ],
    "baseUrl": ".",
    "typeRoots": [
      "./node_modules/@types"
    ],
    "types": [],
    "skipLibCheck": true,
    "paths": {
      "@minecraft/server": [
        "./node_modules/@minecraft/server/index.d.ts"
      ],
      "@minecraft/server-ui": [
        "./node_modules/@minecraft/server-ui/index.d.ts"
      ],
      "@minecraft/common": [
        "./node_modules/@minecraft/common/index.d.ts"
      ]
    }
  },
  "include": [
    "../addon/behavior_pack/scripts/**/*.js",
    "./shims.d.ts"
  ]
}