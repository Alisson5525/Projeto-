{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "jjk:fx_sparks",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/jjk/fx/streak_h"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "math.max(1, math.floor(variable.jjk_count * variable.jjk_density))"
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "variable.jjk_radius",
        "surface_only": true,
        "direction": "outwards"
      },
      "minecraft:particle_initial_speed": "variable.jjk_speed * (0.55 + variable.particle_random_1 * 0.45)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -3,
          0
        ],
        "linear_drag_coefficient": 3.5
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "variable.jjk_life * (0.6 + variable.particle_random_2 * 0.4)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "variable.jjk_size0 * (1 - (variable.particle_age / variable.particle_lifetime) * 0.6)",
          "variable.jjk_size0 * 0.2 * (1 - (variable.particle_age / variable.particle_lifetime) * 0.6)"
        ],
        "facing_camera_mode": "lookat_direction",
        "direction": {
          "mode": "derive_from_velocity",
          "min_speed_threshold": 0.01
        },
        "uv": {
          "texture_width": 1,
          "texture_height": 1,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            1,
            1
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.jjk_r",
          "variable.jjk_g",
          "variable.jjk_b",
          "variable.jjk_a * (1 - math.pow((variable.particle_age / variable.particle_lifetime), 2))"
        ]
      }
    }
  }
}
