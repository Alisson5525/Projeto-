{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "jjk:fx_dots",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/jjk/fx/dot"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "math.max(1, math.floor(variable.jjk_count * variable.jjk_density))"
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "variable.jjk_radius",
        "surface_only": true,
        "direction": "outwards"
      },
      "minecraft:particle_initial_speed": "variable.jjk_speed",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 1.5
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "variable.jjk_life * (0.7 + variable.particle_random_1 * 0.3)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "variable.jjk_size0 * (1 - (variable.particle_age / variable.particle_lifetime))",
          "variable.jjk_size0 * (1 - (variable.particle_age / variable.particle_lifetime))"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 1,
          "texture_height": 1,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            1,
            1
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.jjk_r",
          "variable.jjk_g",
          "variable.jjk_b",
          "variable.jjk_a * (1 - math.pow((variable.particle_age / variable.particle_lifetime), 2))"
        ]
      }
    }
  }
}
