{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.superman.third_person": {
      "geometry": "Geometry.superman",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.superman"
      ],
      "part_visibility": [
        {
          "*": true
        },
        {
          "eye_glow": "v.sm_pow == 3"
        },
        {
          "eyelids": "v.sm_pow != 3 && math.mod(q.life_time, 4.3) < 0.13"
        }
      ]
    },
    "controller.render.superman.first_person": {
      "geometry": "Geometry.superman",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.superman"
      ],
      "part_visibility": [
        {
          "*": false
        },
        {
          "rightArm": "query.get_equipped_item_name(0, 1) == '' || query.get_equipped_item_name(0, 1) == 'filled_map' || q.is_item_name_any('slot.weapon.mainhand', 0, 'superman:emblema', 'superman:voo', 'superman:visao_calor', 'superman:sopro_congelante', 'superman:super_soco', 'superman:impacto')"
        },
        {
          "leftArm": "(query.get_equipped_item_name(0, 1) == 'filled_map' && query.get_equipped_item_name('off_hand') != 'shield') || (query.get_equipped_item_name('off_hand') == 'filled_map' && !query.item_is_charged) || (!query.item_is_charged && (variable.item_use_normalized > 0 && variable.item_use_normalized < 1.0))"
        }
      ]
    }
  }
}