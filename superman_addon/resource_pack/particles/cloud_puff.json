{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "superman:cloud_puff",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/superman_debris"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "v.count ?? 3"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 2.2,
        "surface_only": true,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(1.4, 2.4)"
      },
      "minecraft:particle_initial_speed": "math.random(1.5, 4.5)",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 1.4
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "2.2 + v.particle_random_1 * 2.6",
          "(2.2 + v.particle_random_1 * 2.6) * 0.7"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            "0 + math.floor(v.particle_random_2 * 3.99) * 16",
            112
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1,
          1,
          1,
          "math.min(1.0, v.particle_age * 5.0) * 0.9 * (1.0 - v.particle_age / v.particle_lifetime)"
        ]
      }
    }
  }
}