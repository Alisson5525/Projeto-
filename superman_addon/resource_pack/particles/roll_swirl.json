{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "superman:roll_swirl",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/superman_particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 18
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_disc": {
        "radius": 1.3,
        "plane_normal": [
          "v.dir.x",
          "v.dir.y",
          "v.dir.z"
        ],
        "surface_only": true,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.25, 0.45)"
      },
      "minecraft:particle_initial_speed": "math.random(1, 3)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          "-v.dir.x * 20.0",
          "-v.dir.y * 20.0",
          "-v.dir.z * 20.0"
        ],
        "linear_drag_coefficient": 2
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.7 + v.particle_random_1 * 0.6",
          0.03
        ],
        "facing_camera_mode": "lookat_direction",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            0,
            32
          ],
          "uv_size": [
            32,
            32
          ]
        },
        "direction": {
          "mode": "derive_from_velocity",
          "min_speed_threshold": 0.01
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1,
          1,
          1,
          "0.65 * (1.0 - v.particle_age / v.particle_lifetime)"
        ]
      }
    }
  }
}