{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "superman:heat_beam",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/superman_particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "math.clamp((v.len ?? 8.0) * (v.den ?? 4.0), 2, 320)"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.1"
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "v.dir.x * v.particle_random_1 * (v.len ?? 8.0) + (v.particle_random_2 - 0.5) * 0.04",
          "v.dir.y * v.particle_random_1 * (v.len ?? 8.0) + (v.particle_random_3 - 0.5) * 0.04",
          "v.dir.z * v.particle_random_1 * (v.len ?? 8.0) + (v.particle_random_4 - 0.5) * 0.04"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.13 + v.particle_random_2 * 0.09) * (0.9 + (v.power ?? 0.5) * 0.9)",
          "(0.13 + v.particle_random_2 * 0.09) * (0.9 + (v.power ?? 0.5) * 0.9)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "1.0",
          "0.15 + (v.power ?? 0.5) * 0.35 + v.particle_random_3 * 0.3",
          "0.05 + (v.power ?? 0.5) * 0.15 + v.particle_random_4 * 0.12",
          1.0
        ]
      }
    }
  }
}