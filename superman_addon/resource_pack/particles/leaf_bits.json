{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "superman:leaf_bits",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/superman_debris"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "v.count ?? 7"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.5,
        "direction": [
          "math.random(-1, 1)",
          "math.random(0.2, 1.2)",
          "math.random(-1, 1)"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(2.0, 3.4)"
      },
      "minecraft:particle_initial_speed": "math.random(1.5, 4.5)",
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-260, 260)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          "math.sin(v.particle_age * 380.0 + v.particle_random_1 * 360.0) * 5.0",
          -3.2,
          "math.cos(v.particle_age * 320.0 + v.particle_random_2 * 360.0) * 5.0"
        ],
        "linear_drag_coefficient": 2.4
      },
      "minecraft:particle_motion_collision": {
        "collision_radius": 0.05,
        "coefficient_of_restitution": 0.05,
        "collision_drag": 9
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.12 + v.particle_random_1 * 0.08) * math.clamp((v.particle_lifetime - v.particle_age) * 2.5, 0.0, 1.0)",
          "(0.12 + v.particle_random_1 * 0.08) * math.clamp((v.particle_lifetime - v.particle_age) * 2.5, 0.0, 1.0)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            "0 + math.floor(v.particle_random_2 * 7.99) * 16",
            64
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(v.color.r ?? 0.36) * (0.82 + v.particle_random_3 * 0.4)",
          "(v.color.g ?? 0.56) * (0.82 + v.particle_random_3 * 0.4)",
          "(v.color.b ?? 0.24) * (0.82 + v.particle_random_3 * 0.4)",
          1
        ]
      },
      "minecraft:particle_appearance_lighting": {}
    }
  }
}