{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "superman:punch_wave",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/superman_particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "10 + (v.power ?? 0.5) * 20"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {
        "direction": [
          "v.dir.x + math.random(-0.3, 0.3)",
          "v.dir.y + math.random(-0.3, 0.3)",
          "v.dir.z + math.random(-0.3, 0.3)"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.3, 0.6)"
      },
      "minecraft:particle_initial_speed": "math.random(8, 16) * (0.6 + (v.power ?? 0.5))",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 3.5
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.25 + v.particle_age * 2",
          "0.25 + v.particle_age * 2"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            96,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1,
          1,
          1,
          "0.5 * (1.0 - v.particle_age / v.particle_lifetime)"
        ]
      }
    }
  }
}