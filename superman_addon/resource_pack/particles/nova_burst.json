{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "superman:nova_burst",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/superman_particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 140
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.8,
        "surface_only": true,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.6, 1.1)"
      },
      "minecraft:particle_initial_speed": "math.random(16, 26)",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 2.4
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.4 * (1.0 - v.particle_age / v.particle_lifetime) + 0.1",
          "0.4 * (1.0 - v.particle_age / v.particle_lifetime) + 0.1"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            32,
            64
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "gradient": {
          "0.00": "#FFFFFFFF",
          "0.25": "#FFFFE58A",
          "0.70": "#C0FF9A30",
          "1.00": "#00FF5010"
        },
        "interpolant": "v.particle_age / v.particle_lifetime"
      }
    }
  }
}