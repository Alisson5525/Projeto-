{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "superman:ash_burst",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/superman_debris"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 26
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_box": {
        "half_dimensions": [
          0.3,
          0.9,
          0.3
        ],
        "direction": [
          "math.random(-1, 1)",
          "math.random(0.2, 1.2)",
          "math.random(-1, 1)"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(1.6, 3.0)"
      },
      "minecraft:particle_initial_speed": "math.random(0.5, 2.5)",
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-200, 200)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          "math.sin(v.particle_age * 300.0 + v.particle_random_1 * 360.0) * 2.5",
