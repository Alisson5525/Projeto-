          "math.cos(v.particle_age * 260.0 + v.particle_random_2 * 360.0) * 2.5"
        ],
        "linear_drag_coefficient": 2.2
      },
      "minecraft:particle_motion_collision": {
        "collision_radius": 0.04,
        "coefficient_of_restitution": 0.05,
        "collision_drag": 8
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.06 + v.particle_random_1 * 0.07) * math.clamp((v.particle_lifetime - v.particle_age) * 2.5, 0.0, 1.0)",
          "(0.06 + v.particle_random_1 * 0.07) * math.clamp((v.particle_lifetime - v.particle_age) * 2.5, 0.0, 1.0)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            "0 + math.floor(v.particle_random_2 * 7.99) * 16",
            16
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "0.16 + v.particle_random_3 * 0.22",
          "0.15 + v.particle_random_3 * 0.2",
          "0.14 + v.particle_random_3 * 0.18",
          1
        ]
      },
      "minecraft:particle_appearance_lighting": {}
    }
  }
}