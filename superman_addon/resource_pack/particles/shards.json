      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -18,
          0
        ],
        "linear_drag_coefficient": 0.4,
        "rotation_drag_coefficient": 0.8
      },
      "minecraft:particle_motion_collision": {
        "collision_radius": 0.05,
        "coefficient_of_restitution": 0.45,
        "collision_drag": 5
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.1 + v.particle_random_1 * 0.14) * math.clamp((v.particle_lifetime - v.particle_age) * 2.5, 0.0, 1.0)",
          "(0.1 + v.particle_random_1 * 0.14) * math.clamp((v.particle_lifetime - v.particle_age) * 2.5, 0.0, 1.0)"
