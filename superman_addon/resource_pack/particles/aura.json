{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "superman:aura",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/superman_particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 6
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "(v.radius ?? 1.0)",
        "surface_only": true,
        "direction": [
          "math.random(-0.3, 0.3)",
          1,
          "math.random(-0.3, 0.3)"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.5, 0.9)"
      },
      "minecraft:particle_initial_speed": "math.random(0.6, 1.6)",
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": 180
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          1.5,
          0
        ],
        "linear_drag_coefficient": 1
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.12 * (1.0 - v.particle_age / v.particle_lifetime) + 0.03",
          "0.12 * (1.0 - v.particle_age / v.particle_lifetime) + 0.03"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            32,
            64
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "gradient": {
          "0.00": "#00FFF5C8",
          "0.20": "#FFFFE07A",
          "0.70": "#C0FFB040",
          "1.00": "#00FF7A20"
        },
        "interpolant": "v.particle_age / v.particle_lifetime"
      }
    }
  }
}