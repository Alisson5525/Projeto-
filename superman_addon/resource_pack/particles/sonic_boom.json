{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "superman:sonic_boom",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/superman_particles"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.rad = (v.radius ?? 3.0) * 1.0;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.45"
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.3 + v.rad * math.sqrt(v.particle_age / v.particle_lifetime)",
          "0.3 + v.rad * math.sqrt(v.particle_age / v.particle_lifetime)"
        ],
        "facing_camera_mode": "direction_z",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            0,
            64
          ],
          "uv_size": [
            32,
            32
          ]
        },
        "direction": {
          "mode": "custom",
          "custom_direction": [
            "v.dir.x",
            "v.dir.y",
            "v.dir.z"
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1,
          1,
          1,
          "0.9 * (1.0 - v.particle_age / v.particle_lifetime)"
        ]
      }
    }
  }
}