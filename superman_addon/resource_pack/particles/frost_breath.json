          "v.dir.x + math.random(-0.22, 0.22)",
          "v.dir.y + math.random(-0.22, 0.22)",
          "v.dir.z + math.random(-0.22, 0.22)"
        ]
      },
      "minecraft:particle_lifetime_expression": {
