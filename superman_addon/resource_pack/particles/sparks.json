{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "superman:sparks",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/superman_debris"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "v.count ?? 10"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.2,
        "direction": [
          "math.random(-1, 1)",
          "math.random(-0.2, 1.2)",
          "math.random(-1, 1)"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.25, 0.6)"
      },
      "minecraft:particle_initial_speed": "math.random(6, 14)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -18,
          0
        ],
        "linear_drag_coefficient": 1.2
      },
      "minecraft:particle_motion_collision": {
        "collision_radius": 0.03,
        "coefficient_of_restitution": 0.4,
        "collision_drag": 3
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.22 * (1.0 - v.particle_age / v.particle_lifetime) + 0.04",
          0.05
        ],
        "facing_camera_mode": "lookat_direction",
        "direction": {
          "mode": "derive_from_velocity",
          "min_speed_threshold": 0.01
        },
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            "64 + math.floor(v.particle_random_2 * 3.99) * 16",
            112
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "gradient": {
          "0.00": "#FFFFF6C8",
          "0.35": "#FFFFB040",
          "1.00": "#00E04010"
        },
        "interpolant": "v.particle_age / v.particle_lifetime"
      }
    }
  }
}