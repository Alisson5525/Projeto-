{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "superman:transform_burst",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/superman_particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 60
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.4,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.5, 1.2)"
      },
      "minecraft:particle_initial_speed": "math.random(4, 11)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -3,
          0
        ],
        "linear_drag_coefficient": 2.2
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.18 * (1.0 - v.particle_age / v.particle_lifetime) + 0.04",
          "0.18 * (1.0 - v.particle_age / v.particle_lifetime) + 0.04"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            32,
            64
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "v.particle_random_1 < 0.4 ? 0.3 : 1.0",
          "v.particle_random_1 < 0.4 ? 0.55 : (v.particle_random_1 < 0.75 ? 0.2 : 0.85)",
          "v.particle_random_1 < 0.4 ? 1.0 : 0.2",
          "1.0 - v.particle_age / v.particle_lifetime"
        ]
      }
    }
  }
}