        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            96,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          0.95,
