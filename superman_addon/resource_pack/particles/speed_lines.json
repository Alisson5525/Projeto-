          "texture_height": 128,
          "uv": [
            0,
            32
          ],
          "uv_size": [
            32,
            32
          ]
        },
        "direction": {
          "mode": "custom",
          "custom_direction": [
            "v.dir.x",
            "v.dir.y",
            "v.dir.z"
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
