        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            32,
            64
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "gradient": {
          "0.00": "#00FFFFFF",
          "0.50": "#FFFFE58A",
          "1.00": "#FFFFB040"
