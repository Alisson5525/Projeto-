{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "superman:sun_pillar",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/superman_particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 90
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.5, 1.0)"
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "(v.particle_random_2 - 0.5) * 1.6 * (1.0 - v.particle_age / v.particle_lifetime)",
          "v.particle_random_1 * (v.height ?? 28.0) + v.particle_age * 6.0",
          "(v.particle_random_3 - 0.5) * 1.6 * (1.0 - v.particle_age / v.particle_lifetime)"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.35 + v.particle_random_4 * 0.4",
          "0.35 + v.particle_random_4 * 0.4"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "gradient": {
          "0.00": "#00FFFFFF",
          "0.15": "#FFFFF6C8",
          "0.60": "#C0FFD060",
          "1.00": "#00FF9030"
        },
        "interpolant": "v.particle_age / v.particle_lifetime"
      }
    }
  }
}