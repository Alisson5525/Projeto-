{
  "namespace": "hud",
  "mob_effects_renderer": {
    "visible": false
  },
  "hud_player_renderer": {
    "visible": false
  },
  "item_name_text@hud.item_name_text_root": {
    "visible": false
  },
  "armor_renderer": {
    "visible": false,
    "bindings": []
  },
  "heart_renderer": {
    "visible": false,
    "bindings": []
  },
  "anim_item_name_text_alpha_out": {
    "anim_type": "alpha",
    "easing": "in_expo",
    "destroy_at_end": "$destroy_id",
    "duration": 0,
    "from": 0,
    "to": 0
  },
  "hud_title_text": {
    "visible": false
  },
  "anim_title_text_alpha_out": {
    "anim_type": "alpha",
    "easing": "in_expo",
    "duration": 3,
    "from": 1,
    "to": 0,
    "destroy_at_end": "hud_title_text"
  },
 "hud_actionbar_text": {
    "type": "image",
    "anchor_from": "center",
    "anchor_to": "center",
    "offset": [0, 70], 
    "size": [
      100,
      25
    ],
    "texture": "textures/ui/in",
    "controls": [
      {
        "actionbar_message": {
          "type": "label",
          "anchor_from": "center",
          "anchor_to": "center",
          "offset": [0, 0],
          "color": "$tool_tip_text",
          "text": "$actionbar_text",
          "text_alignment": "left",
          "shadow": true,
          "font_type": "MinecraftTen",
          "font_scale_factor": 0.8,
          "layer": 6
        }
      }
    ]
  },
  
  



  
  "root_panel": {
    "type": "panel",
    "modifications": [
      {
        "control_name": "chat_stack",
        "operation": "remove"
      },
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          {
            "custom_chat_stack": {
              "type": "stack_panel",
              "orientation": "vertical",
              "size": [ "30%", "0%" ],
              "anchor_from": "bottom_left",
              "anchor_to": "bottom_left",
              "controls": [
                {
                  "chat_panel@hud.chat_panel": {}
                }
              ]
            }
          },
          {
            "player_position@hud.player_position": {
              "anchor_from": "bottom_right",
              "anchor_to": "bottom_right",
              "offset": [0, -10]
            }
          },
         {"charge_bijuu@charge_bijuu.charge_bijuu_panel": {}},  
         {"barra_vida_chakra_panel@barra_vida_chakra.barra_vida_chakra_panel": {}},  
         {"hud_jutsu_panel@hud_jutsu.hud_jutsu_panel": {}},  
         {"skill_modos_panel@skill_modos.skill_modos_panel": {}},  
         {"chakra_panel@chakra.chakra_panel": {}},  
         {"hp_panel@hp.hp_panel": {}}
        ]
      }
    ]
  }
}
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        
                                        