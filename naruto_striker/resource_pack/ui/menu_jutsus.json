{
  "namespace": "menu_jutsus",
  "input": {
    "type": "panel",
    "controls": [
      {
        "@server_form.menu_jutsus": {
          "$view_content": "@menu_jutsus.interface_content",
          "bindings": [
            {
              "binding_name": "#title_text",
              "binding_type": "global"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#title_text = 'ui.menu_jutsus.title')",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },

  "interface_content": {
    "type": "panel",
    "controls": [
      {
        "title": {
          "type": "label",
          "size": ["default", 10],
          "offset": [0, -714],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "text": "#title_text",
          "line_padding": 2,
          "text_alignment": "left",
          "color": "$title_text_color"
        }
      },

            {
        "buttons": {
          "type": "panel",
          "$border_visible": false,
          "controls": [


{"button_sair": {
"type": "stack_panel",
"size": [20.2, 20.2],
"anchor_from": "center",
"anchor_to": "center",
"$default_button_texture": "textures/ui/sair",
"$hover_button_texture": "textures/ui/sair_select",
"$pressed_button_texture": "textures/ui/sair_select",
"offset": [-5, 0],
"collection_name": "form_buttons",
"controls": [{
"button@server_form.tnt_form_button": {
"size": ["100%", "100%"] }}]}},










