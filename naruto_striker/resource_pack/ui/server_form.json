  "tnt_form_button@common_buttons.light_text_button": {
    "$pressed_button_name": "button.form_button_click",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "size": "$button_size",
    "$button_size|default": ["fill", 32],
    "$border_visible": false,
    "$button_text_binding_type": "collection",
    "$button_text_grid_collection_name": "form_buttons",
    "$button_type_panel": "server_form.tnt_button_label",
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      }
    ]
  },

  "tnt_view_content": {
    "type": "panel",
    "layer": 1,
    "controls": [
      {
        "$view_content": {}
      }
    ]
  },

  "tnt_button_label": {
    "type": "label",
    "anchor_from": "$button_label_from",
    "anchor_to": "$button_label_to",
    "text": "#form_button_text",
    "text_alignment": "left",
    "font_scale_factor": "$font_scale_factor",
    "color": "$color",
    "max_size": "$button_text_max_size",
    "$font_scale_factor|default": 1,
    "$color|default": "$light_button_default_text_color",
    "$button_text_max_size|default": ["110%", 20],
    "$button_label_from|default": "left",
    "$button_label_to|default": "left",
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      }
    ]
  }
