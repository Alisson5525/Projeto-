    "controller.render.manto_kurama_1": {
      "arrays": {
        "textures": {
          "Array.frame": [
            "Texture.manto_kurama_1_f1",
            "Texture.manto_kurama_1_f2",
            "Texture.manto_kurama_1_f3"
          ]
        }
      },
      "geometry":"Geometry.manto_kurama_1",
      "materials":[{"*":"Material.trasparente"}],
      "rebuild_animation_matrices": true,
      "textures":["Array.frame[(query.anim_time * 3)]" ],
        "part_visibility": [
        { "*": "!variable.is_first_person" },
