{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "tnt:corvos_juntar",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particle/uchiha/corvos"
		}
		},
		"curves": {
			"variable.size": {
				"type": "linear",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [0, 1, 1, 1, 0]
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 100,
				"max_particles": 100
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.5
			},
			"minecraft:emitter_shape_box": {
				"offset": [0, 1, 0],
				"half_dimensions": [3, 3, 3],
				"surface_only": true,
				"direction": "inwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 1
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(-180, 180)"
			},
			"minecraft:particle_initial_speed": 6,
			"minecraft:particle_motion_dynamic": {
				"linear_drag_coefficient": 1
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["variable.size * 0.25", "variable.size * 0.25"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": ["Math.floor(v.particle_random_3 * 2) * 8", "Math.floor(v.particle_random_4 * 2) * 8"],
					"uv_size": [8, 8]
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_drag": 0.4,
				"collision_radius": 0.2
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "0+v.particle_random_3+v.particle_age/4",
					"gradient": {
						"0.09": "#00000000",
						"0.24": "#FFFFFFFF",
						"0.31": "#D6000000",
						"0.94": "#FF000000",
						"1.0": "#00FFFFFF"
					}
				}
			}
		}
	}
}