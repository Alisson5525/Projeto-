        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": {
            "0.0": [
              0.8,
              1,
              0.4,
              0
            ],
            "0.2": [
              0.8,
              1,
              0.4,
              1
            ],
            "0.8": [
              0.8,
              1,
              0.4,
              1
            ],
            "1.0": [
              0.8,
