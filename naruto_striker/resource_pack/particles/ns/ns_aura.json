{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "tnt:ns_aura",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/ns_fx"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 6
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.25
      },
      "minecraft:emitter_shape_disc": {
        "radius": 0.55,
        "plane_normal": "y",
        "surface_only": true,
        "direction": [
          0,
          1,
          0
        ],
        "offset": [
          0,
          0.1,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.7 + math.random(0, 0.5)"
      },
      "minecraft:particle_initial_speed": "math.random(1.2, 2.4)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.8,
          0
        ],
        "linear_drag_coefficient": 1.2
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.28 * (1 - v.particle_age / v.particle_lifetime * 0.6)",
          "0.42 * (1 - v.particle_age / v.particle_lifetime * 0.4)"
        ],
        "facing_camera_mode": "lookat_y",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            32,
            64
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.cor_r > 0 ? variable.cor_r : 0.35",
          "variable.cor_g > 0 ? variable.cor_g : 0.7",
          "variable.cor_b > 0 ? variable.cor_b : 1.0",
          "1 - math.pow(v.particle_age / v.particle_lifetime, 2)"
        ]
      }
    }
  }
}