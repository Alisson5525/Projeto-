                      {"controller.render.masculino_escuro.third_person": "!variable.is_first_person && query.property('tnt:retirar_pele') != 1 && query.property('tnt:custon') == 2"},

                      { "controller.render.player.first_person": "variable.is_first_person" },{ "controller.render.player.third_person": "!variable.is_first_person && !variable.map_face_icon" },{ "controller.render.player.map": "variable.map_face_icon" }
      ],
      "enable_attachables": true
    }
  }
}
