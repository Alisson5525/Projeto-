{
  "format_version": "1.19.0",
  "animation_controllers": {
    "controller.animation.jutsus": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "transitions": [
            {
              "rasen_shuriken": "query.is_using_item && query.get_equipped_item_name == 'rasen_shuriken'"
            }
          ],
          "blend_transition": 0.2,
          "blend_via_shortest_path": true
        },
        "rasen_shuriken": {
          "animations": [
            {
              "rasen_shuriken.terceira": "!v.is_first_person"
            },
            {
              "rasen_shuriken.primeira": "v.is_first_person"
            }
          ],
          "transitions": [
            {
              "idle": "q.all_animations_finished && !query.is_using_item"
            }
          ],
          "blend_transition": 0.2,
          "blend_via_shortest_path": true
        }
      }
    }
  }
}