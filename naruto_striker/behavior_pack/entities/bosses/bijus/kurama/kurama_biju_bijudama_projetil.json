{
    "format_version": "1.19.0",
    "minecraft:entity": {
      "description": {
        "identifier": "tnt:kurama_biju_bijudama_projetil",
        "is_spawnable": false,
        "is_summonable": true,
        "is_experimental": false,
        "runtime_identifier": "minecraft:snowball"
      },
      "component_groups": {
     "tnt:despawn": {
        "minecraft:transformation": {
          "into": "tnt:despawn",
          "delay": 0.0
        }
      },
      "despawning": {
        "minecraft:type_family": {
          "family": [ "despawer","despawer_despawning" ]
        }
      }
      },
      "components": {
      "minecraft:environment_sensor": {
        "triggers": [
                    {
            "filters": {},
            "event": "tnt:tick"
          },
                    {
            "filters": {
          "test": "has_tag",
          "operator": "==",
          "value": "impact_skill"

            },
            "event": "tnt:impact_rasen"
          }
        ]
      },
      "minecraft:timer": {
        "time": 5,
        "looping": true,
        "time_down_event": {
          "event": "tnt:despawn"
        }
      },


        
        "minecraft:collision_box": {
          "width": 0.25,
          "height": 0.25
        },
        "minecraft:projectile": {
         "on_hit": {
          
     "definition_event": {
      "affect_projectile": true,
      "event_trigger": {
            "event": "on:hit",
            "target": "self"
      }
     },
      "impact_damage": {
              "damage": 10
            }
    },
          "power": 2.5,
          "gravity": 0.0,
        "offset": [ 0, 3, 2 ]
        },
        "minecraft:physics": {}
      },
      "events": {
        
"tnt:tick": {
"queue_command":{
"command":[
"tag @e[rm=1,r=5] add impact_skill"
]}},  
    
"tnt:impact_rasen": {
"queue_command":{
"command":[
"playsound ambient.weather.lightning.impact @a[r=25]",
"damage @e[r=5] 20",
"particle tnt:bijudama_impact_1"
]},  
"add": {"component_groups": ["tnt:despawn"]}},

"tnt:despawn": {
"add": {"component_groups": ["tnt:despawn"]}
        },

        "on:hit": {
           "queue_command": {
                "command": [
                "playsound ambient.weather.lightning.impact @a[r=25]",
                "particle tnt:bijudama_impact_1",
                "damage @e[r=5] 20",
                "kill @s"

                ]
              }
        }
      }
    }
  }