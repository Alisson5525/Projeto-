{
    "format_version": "1.10.0",
    "animation_controllers": {
         "controller.animation.mao_terra": {
      "states": {
        "default": {
          "transitions": [
            { "mao_terra": "q.scoreboard('chakra') >= 90 && query.get_equipped_item_name=='mao_terra' && query.is_using_item"}
          ]
        },
        "mao_terra": {
          "animations": ["mao_terra_load_animaation"],
          "on_exit": [
            "/playsound mob.enderdragon.flap @a[r=15] ~ ~ ~ 1 1.5",
            "/scoreboard players remove @s chakra 90",
            "/tag @s add mao_terra",
            "/damage @e[rm=1,r=4] 20"
            

          ],
          "transitions": [
            { "default": "!query.is_using_item" }
          ]
        }
      }
    }
    }
}
