    "controller.animation.skill_mgk_itachi": {
      "states": {
        "default": {
          "transitions": [
            { "amaterasu": "q.scoreboard('chakra') >= 125 && query.get_equipped_item_name == 'mgk_itachi_skill_1' && q.is_using_item" },
            { "corvos": "q.scoreboard('chakra') >= 70 && query.get_equipped_item_name == 'mgk_itachi_skill_2' && q.is_using_item" },
            { "amaterasu_teleguiado": "q.scoreboard('chakra') >= 100 && query.get_equipped_item_name == 'mgk_itachi_skill_3' && q.is_using_item" },
            { "amaterasu_retirar": "q.scoreboard('chakra') >= 40 && query.get_equipped_item_name == 'mgk_itachi_skill_4' && q.is_using_item" }
         
            
           ]
        },

        "amaterasu": {
          "transitions": [{"default":"!q.is_using_item"}],
          "on_entry": [
            "/scoreboard players remove @s chakra 125",
            "/playsound previsao_sharingan @a[r=10] ^^^1",
            "/camerashake add @s 3 0.1 positional ",
            "/execute positioned ^^^6 run tag @e[tag=!jutsu_absover,r=5,tag=!amaterasu,c=1] add amaterasu"
            ]},


       "corvos": {
       "on_entry": ["/scoreboard players remove @s chakra 70"],
       "animations": ["corvos_mgk_itachi"],
       "transitions": [{"default": "query.all_animations_finished"}]},


       "amaterasu_teleguiado": {
       "on_entry": ["/scoreboard players remove @s chakra 100"],
       "animations": ["amaterasu_mgk_itachi"],
       "transitions": [{"default": "query.all_animations_finished"}]},

        "amaterasu_retirar": {
          "transitions": [{"default":"!q.is_using_item"}],
          "on_entry": [
            "/scoreboard players remove @s chakra 40",
            "/playsound previsao_sharingan @a[r=10] ^^^1",
            "/camerashake add @s 3 0.1 positional ",
            "/tag @s remove amaterasu",
            "/execute positioned ^^^6 run tag @e[r=5,tag=amaterasu,c=1] remove amaterasu"
            ]}  
}},









