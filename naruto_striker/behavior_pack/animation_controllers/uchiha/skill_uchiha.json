{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.troca_skill_sharingan": {
      "states": {
        "default": {
          "transitions": [
            { "troca_genjutsu": "query.get_equipped_item_name == 'sharingan_skill_1' && query.is_sneaking" },
        
            { "traca_previsao_atk": "query.get_equipped_item_name == 'sharingan_skill_2' && query.is_sneaking" }
         
            
           ]
        },
        "troca_genjutsu": {
          "on_entry": ["/replaceitem entity @s slot.weapon.mainhand 0 tnt:sharingan_skill_2 1 0 {\"minecraft:keep_on_death\":{},\"item_lock\":{\"mode\":\"lock_in_slot\"}}"],
          "transitions": [{"default": "!query.is_sneaking"}]},

        "traca_previsao_atk": {
            "on_entry": ["/replaceitem entity @s slot.weapon.mainhand 0 tnt:sharingan_skill_1 1 0 {\"minecraft:keep_on_death\":{},\"item_lock\":{\"mode\":\"lock_in_slot\"}}"],
            "transitions": [{"default": "!query.is_sneaking"}]}


      }
    },
    "controller.animation.skill_sharingan": {
      "states": {
        "default": {
          "transitions": [
            { "genjutsu": "q.scoreboard('chakra') >= 70 && query.get_equipped_item_name == 'sharingan_skill_1' && q.is_using_item" },
            { "previsao_sharingan": "q.scoreboard('chakra') >= 40 && query.get_equipped_item_name == 'sharingan_skill_2' && q.is_using_item" }
         
            
           ]
        },

        "genjutsu": {
          "transitions": [{"default":"!q.is_using_item"}],
          "on_entry": [
            "/playsound genjutsu @a[r=10] ^^^1 1 1",
            "/scoreboard players remove @s chakra 70",
            "/camerashake add @s 3 0.1 positional ",
            "/execute positioned ^^^6 run playanimation @e[r=5,tag=!genjutsu,c=2] animation.genjutsu",
            "/execute positioned ^^^6 run tag @e[r=5,tag=!genjutsu,c=2] add genjutsu"
            ]},

       "previsao_sharingan": {
       "on_entry": ["/scoreboard players remove @s chakra 40"],
       "animations": ["previsao_sharingan"],
       "transitions": [{"default": "query.all_animations_finished"}]}


      }
    },










