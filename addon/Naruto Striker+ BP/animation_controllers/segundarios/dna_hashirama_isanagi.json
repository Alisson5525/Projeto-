{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.dna_hashirama_isanagi": {
      "states": {
        "default": {
          "transitions": [
            {
              "walk": "(query.scoreboard('isanagi') <= 6) && q.health < 10"
            }
          ]
        },
        "walk": {
          "transitions": [
            {
              "default": "q.health > 10"
            }
          ],
          "on_entry": [
            "/playanimation @s animation.izanagi_p default 0.2",
            "/playsound conduit.deactivate @a[r=8] ~ ~ ~ 0.5 1.4",
            "/particle minecraft:totem_particle ~ ~2 ~",
            "/scoreboard  players add @s isanagi 1",
            "/camerashake add @s 1 0.2 positional",
            "/effect @s instant_health 1 3 true"
          
          ]
        }
      }
    }
  }
}