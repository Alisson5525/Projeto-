{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "tnt:ns_trilha",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/ns_fx"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 2
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.1
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.15
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.35 + math.random(0, 0.15)"
      },
      "minecraft:particle_initial_speed": 0.2,
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 2
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.32 * (1 - v.particle_age / v.particle_lifetime) + 0.04",
          "0.32 * (1 - v.particle_age / v.particle_lifetime) + 0.04"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.cor_r > 0 ? variable.cor_r : 0.35",
          "variable.cor_g > 0 ? variable.cor_g : 0.7",
          "variable.cor_b > 0 ? variable.cor_b : 1.0",
          "1 - math.pow(v.particle_age / v.particle_lifetime, 2)"
        ]
      }
    }
  }
}