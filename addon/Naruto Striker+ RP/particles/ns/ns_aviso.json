{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "tnt:ns_aviso",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/ns_fx"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {
        "offset": [0, 0.02, 0]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.3
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_dynamic": {},
      "minecraft:particle_appearance_billboard": {
        "size": ["0.22 + 0.06 * math.sin(v.particle_age * 1200)", "0.22 + 0.06 * math.sin(v.particle_age * 1200)"],
        "facing_camera_mode": "emitter_transform_xz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [32, 96],
          "uv_size": [32, 32]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.cor_r > 0 ? variable.cor_r : 1.0",
          "variable.cor_g > 0 ? variable.cor_g : 0.15",
          "variable.cor_b > 0 ? variable.cor_b : 0.1",
          "0.95 - v.particle_age / v.particle_lifetime * 0.5"
        ]
      }
    }
  }
}
