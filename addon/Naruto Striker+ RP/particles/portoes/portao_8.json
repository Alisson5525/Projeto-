{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "tnt:portao_8",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particle/fire"
			}
		},
		"components": {
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": true,
				"velocity": true
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 30,
				"max_particles": 30
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 3
			},
			"minecraft:emitter_shape_box": {
				"offset": [0, 0.4, 0],
				"half_dimensions": [0.4, 0.7, 0.4],
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 1
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(-180, 180)"
			},
			"minecraft:particle_initial_speed": 0.4,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, 5, 0]
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["0.04 + (2.7* variable.particle_age)", "0.04 + (2.7* variable.particle_age)"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 240,
					"texture_height": 48,
					"flipbook": {
						"base_UV": [0, "math.round(v.particle_random_3)*24"],
						"size_UV": [24, 24],
						"step_UV": [24, 0],
						"frames_per_second": 10,
						"max_frame": 10,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#24FF0000",
						"1.0": "#00FF371A"
					}
				}
			}
		}
	}
}