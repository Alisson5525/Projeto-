{
    "format_version": "1.16.200",
    "animation_controllers": {
        "controller.animation.scrubel.held_item_checker": {
            "initial_state": "no_held_item",
            "states": {
                "no_held_item": {
                    "on_entry": [
                        "/event entity @s mm:held_item_removed"
                    ],
                    "transitions": [
                        {
                            "held_item": "query.is_item_equipped(0) == 1"
                        }
                    ]
                },
                "held_item": {
                    "on_entry": [
                        "/event entity @s mm:held_item_gained",
                        "/playsound mob.scrubel.pickup @a[r=16] ~~~ 1.0 1.0"
                    ],
                    "on_exit": [
                        "/playsound mob.scrubel.store @a[r=16] ~~~ 1.0 0.7"
                    ],
                    "transitions": [
                        {
                            "no_held_item": "query.is_item_equipped(0) == 0"
                        }
                    ]
                }
            }
        }
    }
}