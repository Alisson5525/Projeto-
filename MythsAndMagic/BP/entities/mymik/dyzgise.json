                            "range": [
                                8,
                                8
                            ],
                            "minimum_count": 0,
                            "event": "mm:ranged_attack",
                            "event_filters": [
                                {
                                    "all_of": [
                                        {
                                            "test": "is_target",
                                            "subject": "other",
                                            "value": true
                                        },
                                        {
                                            "test": "has_target",
                                            "subject": "self",
                                            "value": true
                                        },
                                        {
                                            "test": "target_distance",
                                            "value": 12,
