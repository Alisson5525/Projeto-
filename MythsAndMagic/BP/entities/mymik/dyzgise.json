        "events": {
            "minecraft:entity_spawned": {
                "add": {
                    "component_groups": [
                        "mm:open",
                        "mm:ranged_attack_ready"
                    ]
                }
            },
            "mm:spawn_closed": {
                "add": {
                    "component_groups": [
                        "mm:closed"
                    ]
                }
            },
            "mm:spawn_opened": {
                "add": {
                    "component_groups": [
                        "mm:open",
                        "mm:ranged_attack_ready"
                    ]
                }
            },
            "mm:open": {
                "queue_command": {
                    "command": [
                        "playsound mob.dyzgise.wake_up @a ~~~"
                    ]
                },
                "add": {
                    "component_groups": [
                        "mm:opening"
                    ]
                }
            },
            "mm:open_finish": {
                "add": {
                    "component_groups": [
                        "mm:open",
                        "mm:ranged_attack_ready"
                    ]
                },
                "remove": {
                    "component_groups": [
                        "mm:closed",
                        "mm:opening"
                    ]
                }
            },
            "mm:ranged_attack_enabled": {
                "queue_command": {
                    "command": [
                        "tag @s remove mm:mymik_pulling"
                    ]
                },
                "add": {
                    "component_groups": [
                        "mm:ranged_attack_ready"
                    ]
                },
                "remove": {
                    "component_groups": [
                        "mm:ranged_attack_cooldown",
                        "mm:ranged_attacking"
                    ]
                }
            },
            "mm:ranged_attack_end": {
                "queue_command": {
                    "target": "target",
                    "command": [
                        "tag @s add mm:mymik_pull",
                        "damage @s 6 entity_attack entity @e[type=mm:dyzgise,c=1,tag=mm:mymik_pulling]"
                    ]
                },
                "add": {
                    "component_groups": [
                        "mm:ranged_attack_cooldown"
                    ]
                },
                "remove": {
                    "component_groups": [
                        "mm:ranged_attack_ready",
                        "mm:ranged_attacking"
                    ]
                }
            },
            "mm:ranged_attack": {
                "queue_command": {
                    "command": [
                        "tag @s add mm:mymik_pulling",
                        "effect @s slowness 2 12 true",
                        "scriptevent mm:mymik_ranged_timeout"
                    ]
                },
                "add": {
                    "component_groups": [
                        "mm:ranged_attacking"
                    ]
                },
                "remove": {
                    "component_groups": [
                        "mm:ranged_attack_cooldown",
                        "mm:ranged_attack_ready"
                    ]
                }
