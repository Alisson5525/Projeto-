                        {
                            "cooldown": 1,
                            "interact_text": "Open",
                            "on_interact": {
                                "event": "mm:open",
                                "target": "self"
                            }
                        }
                    ]
                },
                "minecraft:collision_box": {
                    "width": 0.7,
                    "height": 0.95
                }
            },
