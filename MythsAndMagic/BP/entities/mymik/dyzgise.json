                            "deals_damage": "yes",
                            "damage_multiplier": 0.5,
                            "on_damage": {
                                "event": "mm:open",
                                "target": "self"
                            }
                        },
                        {
                            "cause": "all",
                            "deals_damage": "no"
                        }
                    ]
                },
                "minecraft:entity_sensor": {
                    "find_players_only": true,
                    "subsensors": [
                        {
                            "cooldown": -1,
                            "event": "mm:open",
                            "minimum_count": 1,
                            "range": [
                                5,
                                5
                            ],
                            "event_filters": [
                                {
                                    "all_of": [
                                        {
                                            "any_of": [
                                                {
                                                    "all_of": [
                                                        {
                                                            "test": "is_moving",
                                                            "subject": "other",
                                                            "value": true
                                                        },
                                                        {
                                                            "test": "is_sneaking",
                                                            "subject": "other",
                                                            "value": false
                                                        }
                                                    ]
                                                },
                                                {
                                                    "test": "has_container_open",
                                                    "subject": "other",
                                                    "value": true
                                                }
                                            ]
                                        },
                                        {
                                            "test": "is_difficulty",
                                            "value": "peaceful",
                                            "operator": "not"
                                        },
                                        {
                                            "test": "has_ability",
                                            "value": "instabuild",
                                            "subject": "other",
                                            "operator": "!="
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                "minecraft:variant": {
                    "value": 0
