{
  "format_version": "1.21.90",
  "minecraft:entity": {
    "description": {
      "identifier": "mm:revoid",
      "spawn_category": "monster",
      "is_spawnable": true,
      "is_summonable": true,
      "properties": {
        "mm:crouched": {
          "client_sync": true,
          "default": false,
          "type": "bool"
        }
      }
    },
    "component_groups": {
      "mm:transient": {
        "minecraft:transient": {}
      },
      "mm:crouched": {
        "minecraft:collision_box": {
          "height": 1.4,
          "width": 0.88
        }
      },
      "mm:uncrouched": {
        "minecraft:collision_box": {
          "height": 3.5,
          "width": 0.5
        }
      },
      "mm:state_cooldown": {
        "minecraft:attack_cooldown": {
          "attack_cooldown_time": 2,
          "attack_cooldown_complete_event": {
            "event": "mm:state_cooldown_over"
          }
        }
      },
      "mm:has_target": {
        "minecraft:spawn_entity": {
          "entities": {
            "min_wait_time": 10,
            "max_wait_time": 10,
            "filters": {
              "subject": "self",
              "test": "has_target",
              "value": true
            },
            "num_to_spawn": 2,
            "spawn_entity": "mm:red_splinters"
          }
        }
      },
      "mm:has_no_target": {},
      "mm:roar": {
        "minecraft:behavior.timer_flag_3": {
          "cooldown_range": 10,
          "duration_range": 1.75,
          "on_end": {
            "event": "mm:finish_roaring"
          },
          "priority": 0
        }
      },
      "mm:risen": {
        "minecraft:variant": {
          "value": 0
        }
      },
      "mm:rising": {
        "minecraft:variant": {
          "value": 1
        },
        "minecraft:timer": {
          "time": 4.8,
          "looping": true,
          "time_down_event": {
            "event": "mm:finish_rising"
          }
        },
        "minecraft:damage_sensor": {
          "triggers": {
            "cause": "all",
            "deals_damage": "no"
          }
        }
      },
      "mm:can_attack": {
        "minecraft:looked_at": {
          "look_at_locations": [
            {
              "location": "body"
            },
            {
              "location": "head"
            }
          ],
          "search_radius": 64.0,
          "set_target": "once_and_stop_scanning",
          "find_players_only": true,
          "min_looked_at_duration": 0.25,
          "filters": {
            "all_of": [
              {
                "test": "has_target",
                "value": false
              },
              {
                "test": "has_equipment",
                "domain": "head",
                "subject": "other",
                "operator": "not",
                "value": "carved_pumpkin"
              },
              {
                "test": "is_difficulty",
                "value": "peaceful",
                "operator": "not"
              }
            ]
          }
        },
        "minecraft:behavior.hurt_by_target": {
          "priority": 1
        },
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 2,
          "entity_types": [
            {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "player"
              },
              "max_dist": 48,
              "must_see": true,
              "must_see_forget_duration": 60
            },
            {
              "max_dist": 8,
              "filters": {
                "all_of": [
                  {
                    "test": "is_family",
                    "value": "player",
                    "subject": "other"
                  }
                ]
              },
              "must_see": false
            }
          ],
          "within_radius": 256,
          "must_reach": false,
          "scan_interval": 200
        },
        "minecraft:behavior.delayed_attack": {
          "melee_fov": 360,
          "attack_duration": 0.46,
          "cooldown_time": 0.5,
          "hit_delay_pct": 0.5,
          "priority": 4,
          "speed_multiplier": 1.2,
          "sound_event": "attack",
          "reach_multiplier": 2.5
        }
      },
      "mm:movement": {
        "minecraft:break_blocks": {
          "breakable_blocks": [
            "mm:alterbrush",
            "oak_leaves",
            "birch_leaves",
            "acacia_leaves",
            "azalea_leaves",
            "azalea_leaves_flowered",
            "cherry_leaves",
            "jungle_leaves",
            "spruce_leaves",
            "dark_oak_leaves",
            "mangrove_leaves",
            "pale_oak_leaves",
            "cobblestone",
            "cobbled_deepslate",
            "mossy_cobblestone",
            "oak_planks",
            "pale_oak_planks",
            "birch_planks",
            "acacia_planks",
            "bamboo_planks",
            "cherry_planks",
            "jungle_planks",
            "spruce_planks",
            "warped_planks",
            "crimson_planks",
            "dark_oak_planks",
            "mangrove_planks",
            "mm:cobbled_alterstone",
            "mm:healthy_twisted_leaves",
            "mm:twisted_leaves"
          ]
        },
        "minecraft:behavior.look_at_target": {
          "priority": 9
        },
        "minecraft:behavior.look_at_player": {
          "priority": 10
        },
        "minecraft:variable_max_auto_step": {
          "base_value": 2.0625,
          "controlled_value": 2.0625,
          "jump_prevented_value": 1.0625
        },
        "minecraft:type_family": {
          "family": ["longshot_unpullable", "alterrealm_mob", "monster", "mob"]
        },
        "minecraft:damage_sensor": {
          "triggers": [
            {
              "cause": "fall",
              "deals_damage": "no"
            },
            {
              "cause": "magic",
              "deals_damage": "no"
            }
          ]
        },
        "minecraft:navigation.walk": {
          "avoid_water": true,
          "can_walk_in_lava": true,
          "can_path_over_water": true,
          "can_path_over_lava": true,
          "avoid_damage_blocks": true
        },
        "minecraft:movement.basic": {},
        "minecraft:jump.static": {},
        "minecraft:can_climb": {},
        "minecraft:preferred_path": {
          "max_fall_blocks": 20
        },
        "minecraft:attack": {
          "damage": 26
        },
        "minecraft:behavior.random_stroll": {
          "interval": 3,
          "priority": 5,
          "xz_dist": 20,
          "speed_multiplier": 0.65
        }
      }
    },
    "components": {
      "minecraft:equipment": {
        "table": "loot_tables/entities/sanctuary_keeper_axe.json",
        "slot_drop_chance": [
          {
            "drop_chance": -1,
            "slot": "slot.weapon.mainhand"
          }
        ]
      },
      "minecraft:mob_effect_immunity": {
        "mob_effects": [
          "weakness",
          "mining_fatigue",
          "blindness",
          "darkness",
          "fatal_poison",
          "hunger",
          "infested",
          "instant_damage",
          "levitation",
          "nausea",
          "oozing",
          "poison",
          "weaving",
          "wind_charged",
          "wither"
        ]
      },
      "minecraft:on_target_acquired": {
        "event": "mm:target_acquired"
      },
      "minecraft:on_target_escape": {
        "event": "mm:target_lost"
      },
      "minecraft:knockback_resistance": {
        "value": 1.0
      },
      "minecraft:collision_box": {
        "width": 0.5,
        "height": 2.9
      },
      "minecraft:is_hidden_when_invisible": {},
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? 50 : 0"
      },
      "minecraft:movement": {
        "value": 0.35
      },
      "minecraft:underwater_movement": {
        "value": 0.4
      },
      "minecraft:lava_movement": {
        "value": 0.4
      },
      "minecraft:health": {
        "value": 500,
        "max": 500
      },
      "minecraft:follow_range": {
        "value": 256,
        "max": 256
      },
      "minecraft:nameable": {},
      "minecraft:physics": {},
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:on_death": {
        "event": "mm:death",
        "target": "self"
      }
    },
    "events": {
      "mm:death": {
        "queue_command": {
          "command": ["stopsound @a[r=512] mob.revoid.chase"]
        }
      },
      "mm:loud_scream": {
        "queue_command": {
          "command": ["scoreboard players set @s mm:revoid_scream 380"]
        }
      },
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "mm:can_attack",
            "mm:movement",
            "mm:risen",
            "mm:uncrouched"
          ]
        }
      },
      "mm:crouch": {
        "queue_command": {
          "command": ["tag @s add mm:state_cooldown"]
        },
        "add": {
          "component_groups": ["mm:crouched", "mm:state_cooldown"]
        },
        "remove": {
          "component_groups": ["mm:uncrouched"]
        },
        "set_property": {
          "mm:crouched": true
        }
      },
      "mm:stand": {
        "queue_command": {
          "command": ["tag @s add mm:state_cooldown"]
        },
        "add": {
          "component_groups": ["mm:uncrouched", "mm:state_cooldown"]
        },
        "remove": {
          "component_groups": ["mm:crouched"]
        },
        "set_property": {
          "mm:crouched": false
        }
      },
      "mm:state_cooldown_over": {
        "queue_command": {
          "command": ["tag @s remove mm:state_cooldown"]
        },
        "remove": {
          "component_groups": ["mm:state_cooldown"]
        }
      },
      "mm:target_acquired": {
        "trigger": "mm:loud_scream",
        "add": {
          "component_groups": ["mm:has_target", "mm:roar"]
        },
        "queue_command": {
          "command": [
            "playanimation @s animation.revoid.roar",
            "effect @s slowness 2 255 true"
          ]
        },
        "remove": {
          "component_groups": ["mm:has_no_target"]
        }
      },
      "mm:target_lost": {
        "queue_command": {
          "command": ["scoreboard players reset @s mm:revoid_scream"]
        },
        "remove": {
          "component_groups": ["mm:has_target"]
        },
        "add": {
          "component_groups": ["mm:has_no_target"]
        }
      },
      "mm:spawn_alterrealm_revoid": {
        "add": {
          "component_groups": ["mm:transient", "mm:rising", "mm:uncrouched"]
        }
      },
      "mm:spawn_alterrealm_revoid_crouched": {
        "add": {
          "component_groups": ["mm:transient", "mm:rising", "mm:crouched"]
        },
        "set_property": {
          "mm:crouched": true
        }
      },
      "mm:spawn_rising": {
        "add": {
          "component_groups": ["mm:rising"]
        }
      },
      "mm:finish_rising": {
        "add": {
          "component_groups": ["mm:can_attack", "mm:movement", "mm:risen"]
        },
        "remove": {
          "component_groups": ["mm:rising"]
        }
      },
      "mm:start_roaring": {
        "add": {
          "component_groups": ["mm:roar"]
        },
        "queue_command": {
          "command": [
            "playanimation @s animation.revoid.roar",
            "effect @s slowness 2 255 true"
          ]
        }
      },
      "mm:finish_roaring": {
        "remove": {
          "component_groups": ["mm:roar"]
        }
      }
    }
  }
}
