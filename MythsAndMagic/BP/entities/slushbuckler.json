{
    "format_version": "1.21.120",
    "minecraft:entity": {
        "description": {
            "identifier": "mm:slushbuckler",
            "spawn_category": "creature",
            "is_spawnable": true,
            "is_summonable": true,
            "properties": {
                "mm:snowstorm": {
                    "client_sync": true,
                    "default": false,
                    "type": "bool"
                }
            }
        },
        "component_groups": {
            "mm:trusted": {
                "minecraft:home": {
                    "restriction_radius": 24,
                    "restriction_type": "random_movement"
                }
            },
            "mm:can_move": {
                "minecraft:knockback_resistance": {
                    "max": 1.0,
                    "value": 1.0
                },
                "minecraft:variable_max_auto_step": {
                    "base_value": 1.0625,
                    "controlled_value": 1.0625,
                    "jump_prevented_value": 0.5625
                },
                "minecraft:movement": {
                    "value": 0.18
                },
                "minecraft:behavior.float": {
                    "priority": 0
                },
                "minecraft:behavior.random_stroll": {
                    "priority": 6,
                    "speed_multiplier": 0.8
                },
                "minecraft:navigation.walk": {
                    "can_path_over_water": false,
                    "avoid_water": true,
                    "avoid_damage_blocks": true
                },
                "minecraft:movement.basic": {},
                "minecraft:jump.static": {},
                "minecraft:can_climb": {}
            },
            "mm:cannot_move": {
                "minecraft:knockback_resistance": {
                    "max": 1,
                    "value": 1
                },
                "minecraft:movement": {
                    "value": 0
                }
            },
            "mm:no_popsicle": {
                "minecraft:variant": {
                    "value": 0
                },
                "minecraft:behavior.tempt": {
                    "items": [
                        "mm:popsicle"
                    ],
                    "within_radius": 24,
                    "priority": 1,
                    "speed_multiplier": 1.25
                },
                "minecraft:interact": {
                    "interactions": [
                        {
                            "interact_text": "action.interact.popsicle",
                            "vibration": "shear",
                            "use_item": true,
                            "on_interact": {
                                "filters": {
                                    "all_of": [
                                        {
                                            "test": "is_family",
                                            "subject": "other",
                                            "value": "player"
                                        },
                                        {
                                            "test": "has_equipment",
                                            "domain": "hand",
                                            "subject": "other",
                                            "value": "mm:popsicle"
                                        },
                                        {
                                            "test": "is_sitting",
                                            "subject": "self",
                                            "value": false
                                        }
                                    ]
                                },
                                "event": "mm:given_popsicle",
                                "target": "self"
                            }
                        }
                    ]
                }
            },
            "mm:eating_popsicle": {
                "minecraft:variant": {
                    "value": 1
                },
                "minecraft:timer": {
                    "time": 6.05,
                    "time_down_event": {
                        "event": "mm:finished_popsicle",
                        "target": "self"
                    }
                }
            },
            "mm:brainfreeze": {
                "minecraft:variant": {
                    "value": 0
                },
                "minecraft:is_shaking": {},
                "minecraft:timer": {
                    "time": 10.05,
                    "time_down_event": {
                        "event": "mm:brainfreeze_over",
                        "target": "self"
                    }
                }
            }
        },
        "components": {
            "minecraft:loot": {
                "table": "loot_tables/entities/slushbuckler.json"
            },
            "minecraft:behavior.random_look_around_and_sit": {
                "priority": 4,
                "continue_if_leashed": true,
                "min_look_count": 2,
                "max_look_count": 5,
                "min_look_time": 80,
                "max_look_time": 100,
                "min_angle_of_view_horizontal": -30,
                "max_angle_of_view_horizontal": 30,
                "random_look_around_cooldown": 5,
                "probability": 0.005
            },
            "minecraft:experience_reward": {
                "on_death": "query.last_hit_by_player ? Math.Random(1,3) : 0"
            },
            "minecraft:is_hidden_when_invisible": {},
            "minecraft:type_family": {
                "family": [
                    "longshot_heavy",
                    "slushbuckler",
                    "mob"
                ]
            },
            "minecraft:damage_sensor": {
                "triggers": [
                    {
                        "cause": "freezing",
                        "deals_damage": "no"
                    }
                ]
            },
            "minecraft:breathable": {
                "total_supply": 15,
                "suffocate_time": 0
            },
            "minecraft:collision_box": {
                "width": 2.5,
                "height": 4.5
            },
            "minecraft:nameable": {},
            "minecraft:health": {
                "value": 60,
                "max": 60
            },
            "minecraft:hurt_on_condition": {
                "damage_conditions": [
                    {
                        "filters": {
                            "test": "in_lava",
                            "subject": "self",
                            "operator": "==",
                            "value": true
                        },
                        "cause": "lava",
                        "damage_per_tick": 4
                    }
                ]
            },
            "minecraft:behavior.look_at_player": {
                "priority": 7,
                "look_distance": 6.0,
                "probability": 0.02
            },
            "minecraft:behavior.random_look_around": {
                "priority": 9
            },
            "minecraft:physics": {},
            "minecraft:pushable": {
                "is_pushable": false,
                "is_pushable_by_piston": true
            },
            "minecraft:conditional_bandwidth_optimization": {}
        },
        "events": {
            "minecraft:entity_spawned": {
                "add": {
                    "component_groups": [
                        "mm:no_popsicle",
                        "mm:can_move"
                    ]
                }
            },
            "mm:given_popsicle": {
                "add": {
                    "component_groups": [
                        "mm:cannot_move",
                        "mm:eating_popsicle",
                        "mm:trusted"
                    ]
                },
                "remove": {
                    "component_groups": [
                        "mm:can_move",
                        "mm:no_popsicle"
                    ]
                }
            },
            "mm:finished_popsicle": {
                "queue_command": {
                    "command": [
                        "scriptevent mm:slushbuckler_snow"
                    ]
                },
                "add": {
                    "component_groups": [
                        "mm:can_move",
                        "mm:brainfreeze"
                    ]
                },
                "set_home_position": {},
                "remove": {
                    "component_groups": [
                        "mm:cannot_move",
                        "mm:eating_popsicle"
                    ]
                }
            },
            "mm:brainfreeze_over": {
                "add": {
                    "component_groups": [
                        "mm:no_popsicle"
                    ]
                },
                "remove": {
                    "component_groups": [
                        "mm:brainfreeze"
                    ]
                }
            },
            "minecraft:start_sitting": {
                "add": {
                    "component_groups": [
                        "mm:cannot_move"
                    ]
                },
                "remove": {
                    "component_groups": [
                        "mm:can_move"
                    ]
                }
            },
            "minecraft:stop_sitting": {
                "remove": {
                    "component_groups": [
                        "mm:cannot_move"
                    ]
                },
                "add": {
                    "component_groups": [
                        "mm:can_move"
                    ]
                }
            }
        }
    }
}