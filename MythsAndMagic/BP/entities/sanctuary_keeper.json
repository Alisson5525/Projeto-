{
    "format_version": "1.21.120",
    "minecraft:entity": {
        "description": {
            "identifier": "mm:sanctuary_keeper",
            "runtime_identifier": "minecraft:vex",
            "spawn_category": "monster",
            "is_spawnable": true,
            "is_summonable": true,
            "is_experimental": false
        },
        "component_groups": {
            "mm:tick_world": {
                "minecraft:tick_world": {
                    "never_despawn": true,
                    "radius": 2
                },
                "minecraft:entity_sensor": {
                    "find_players_only": true,
                    "subsensors": [
                        {
                            "cooldown": -1,
                            "event": "mm:stop_ticking",
                            "minimum_count": 0,
                            "maximum_count": 0,
                            "range": [
                                256,
                                256
                            ],
                            "event_filters": {
                                "test": "has_tag",
                                "value": "mm:sanctuary_keeper_target",
                                "subject": "other"
                            }
                        }
                    ]
                }
            },
            "mm:despawn": {
                "minecraft:instant_despawn": {
                    "remove_child_entities": true
                }
            },
            "mm:stunned": {
                "minecraft:variant": {
                    "value": 1
                },
                "minecraft:movement": {
                    "value": 2
                },
                "minecraft:flying_speed": {
                    "value": 1.4
                },
                "minecraft:physics": {
                    "has_gravity": true,
                    "has_collision": true
                },
                "minecraft:timer": {
                    "looping": true,
                    "time": 3.333,
                    "time_down_event": {
                        "event": "mm:get_up"
                    }
                }
            },
            "mm:can_move": {
                "minecraft:timer": {
                    "looping": true,
                    "time": 0.1,
                    "time_down_event": {
                        "event": "mm:unstuck",
                        "filters": [
                            {
                                "any_of": [
                                    {
                                        "all_of": [
                                            {
                                                "test": "target_distance",
                                                "operator": ">=",
                                                "value": 12
                                            },
                                            {
                                                "test": "has_target",
                                                "value": true
                                            },
                                            {
                                                "test": "inactivity_timer",
                                                "value": 1,
                                                "operator": ">="
                                            }
                                        ]
                                    },
                                    {
                                        "all_of": [
                                            {
                                                "test": "target_distance",
                                                "operator": ">=",
                                                "value": 24
                                            },
                                            {
                                                "test": "has_target",
                                                "value": true
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                },
                "minecraft:variant": {
                    "value": 0
                },
                "minecraft:behavior.float": {
                    "priority": 0
                },
                "minecraft:follow_range": {
                    "max": 256,
                    "value": 256
                },
                "minecraft:behavior.charge_attack": {
                    "priority": 3,
                    "max_distance": 256,
                    "min_distance": 0,
                    "speed_multiplier": 1.25,
                    "success_rate": 0.2428
                },
                "minecraft:physics": {
                    "has_gravity": false,
                    "has_collision": false
                },
                "minecraft:movement": {
                    "value": 2
                },
                "minecraft:flying_speed": {
                    "value": 1.4
                },
                "minecraft:can_fly": {},
                "minecraft:movement.fly": {},
                "minecraft:can_climb": {},
                "minecraft:behavior.melee_attack": {
                    "priority": 2,
                    "speed_multiplier": 1.3,
                    "track_target": true,
                    "require_complete_path": false,
                    "reach_multiplier": 0.0 // this prevents it from ocasionally performing melee attacks while using this goal to chase
                },
                "minecraft:ravager_blocked": {
                    "knockback_strength": 1,
                    "reaction_choices": [
                        {
                            "weight": 1,
                            "value": {
                                "event": "mm:stun"
                            }
                        }
                    ]
                }
            }
        },
        "components": {
            "minecraft:attack_cooldown": {
                "attack_cooldown_time": 1800,
                "attack_cooldown_complete_event": {
                    "event": "mm:banish",
                    "target": "self"
                }
            },
            "minecraft:navigation.walk": {
                "can_swim": true,
                "can_sink": false,
                "can_path_over_water": false,
                "avoid_water": false,
                "avoid_damage_blocks": false,
                "can_pass_doors": true,
                "can_walk_in_lava": true,
                "is_amphibious": true
            },
            "minecraft:cannot_be_attacked": {},
            "minecraft:is_hidden_when_invisible": {},
            "minecraft:nameable": {},
            "minecraft:damage_sensor": {
                "triggers": [
                    {
                        "cause": "all",
                        "deals_damage": "no_but_side_effects_apply"
                    }
                ]
            },
            "minecraft:type_family": {
                "family": [
                    "longshot_unpullable",
                    "sanctuary_keeper"
                ]
            },
            "minecraft:equipment": {
                "table": "loot_tables/entities/sanctuary_keeper_axe.json",
                "slot_drop_chance": [
                    {
                        "drop_chance": -1,
                        "slot": "slot.weapon.mainhand"
                    }
                ]
            },
            "minecraft:health": {
                "value": 2,
                "max": 2
            },
            "minecraft:attack": {
                "damage": 4.5
            },
            "minecraft:collision_box": {
                "width": 0.001,
                "height": 0.001
            },
            "minecraft:fire_immune": {},
            "minecraft:conditional_bandwidth_optimization": {},
            "minecraft:game_event_movement_tracking": {
                "emit_move": false,
                "emit_swim": false
            },
            "minecraft:on_target_acquired": {
                "event": "mm:tick"
            },
            "minecraft:dimension_bound": {},
            "minecraft:behavior.nearest_prioritized_attackable_target": {
                "priority": 2,
                "must_see": false,
                "reselect_targets": true,
                "within_radius": 512,
                "entity_types": [
                    {
                        "filters": {
                            "all_of": [
                                {
                                    "test": "is_family",
                                    "subject": "other",
                                    "value": "player"
                                },
                                {
                                    "test": "has_tag",
                                    "subject": "other",
                                    "operator": "==",
                                    "value": "mm:sanctuary_keeper_target"
                                }
                            ]
                        },
                        "max_dist": 512,
                        "priority": 0
                    },
                    {
                        "filters": {
                            "all_of": [
                                {
                                    "test": "is_family",
                                    "subject": "other",
                                    "operator": "!=",
                                    "value": "player"
                                },
                                {
                                    "test": "has_tag",
                                    "subject": "other",
                                    "operator": "==",
                                    "value": "mm:sanctuary_keeper_target"
                                }
                            ]
                        },
                        "max_dist": 512,
                        "priority": 1
                    }
                ]
            }
        },
        "events": {
            "mm:banish": {
                "queue_command": {
                    "command": [
                        "particle mm:sanctuary_keeper_banish ~~~",
                        "particle mm:sanctuary_keeper_banish_smoke ~~~",
                        "playsound mob.sanctuary_keeper.banished @a ~~~",
                        "scriptevent mm:sanctuary_keeper_despawn"
                    ]
                }
            },
            "minecraft:entity_spawned": {
                "add": {
                    "component_groups": [
                        "mm:can_move"
                    ]
                }
            },
            "mm:stun_no_target": {
                "add": {
                    "component_groups": [
                        "mm:stunned"
                    ]
                },
                "remove": {
                    "component_groups": [
                        "mm:can_move"
                    ]
                }
            },
            "mm:stun": {
                "queue_command": {
                    "command": [
                        "scriptevent mm:damage_shield"
                    ],
                    "target": "target"
                },
                "add": {
                    "component_groups": [
                        "mm:stunned"
                    ]
                },
                "remove": {
                    "component_groups": [
                        "mm:can_move"
                    ]
                }
            },
            "mm:get_up": {
                "add": {
                    "component_groups": [
                        "mm:can_move"
                    ]
                },
                "remove": {
                    "component_groups": [
                        "mm:stunned"
                    ]
                }
            },
            "mm:tick": {
                "add": {
                    "component_groups": [
                        "mm:tick_world"
                    ]
                }
            },
            "mm:stop_ticking": {
                "remove": {
                    "component_groups": [
                        "mm:tick_world"
                    ]
                }
            },
            "mm:unstuck": {
                "queue_command": {
                    "command": [
                        "teleport ^^^2 facing @p[tag=mm:sanctuary_keeper_target]"
                    ]
                }
            },
            "mm:despawn": {
                "add": {
                    "component_groups": [
                        "mm:despawn"
                    ]
                }
            }
        }
    }
}