{
    "format_version": "1.21.90",
    "minecraft:entity": {
        "description": {
            "identifier": "mm:flickerwick",
            "spawn_category": "creature",
            "is_spawnable": true,
            "is_summonable": true,
            "properties": {
                "mm:wax_remaining": {
                    "type": "int",
                    "default": 20,
                    "range": [
                        0,
                        20
                    ]
                }
            }
        },
        "component_groups": {
            "mm:size_normal": {
                "minecraft:skin_id": {
                    "value": 0
                },
                "minecraft:collision_box": {
                    "width": 0.4,
                    "height": 0.6
                }
            },
            "mm:size_tall": {
                "minecraft:skin_id": {
                    "value": 1
                },
                "minecraft:collision_box": {
                    "width": 0.4,
                    "height": 1.1
                }
            },
            "mm:is_happy": {
                "minecraft:is_saddled": {}
            },
            "mm:expire": {
                "minecraft:body_rotation_blocked": {},
                "minecraft:mark_variant": {
                    "value": 1
                },
                "minecraft:timer": {
                    "time": 1.25,
                    "looping": true,
                    "time_down_event": {
                        "event": "mm:expire",
                        "target": "self"
                    }
                }
            },
            "mm:not_expired": {
                "minecraft:interact": {
                    "interactions": [
                        {
                            "cooldown": 5,
                            "cooldown_after_being_attacked": 5,
                            "use_item": true,
                            "interact_text": "action.interact.wax_on",
                            "vibration": "shear",
                            "swing": true,
                            "on_interact": {
                                "filters": {
                                    "all_of": [
                                        {
                                            "test": "int_property",
                                            "domain": "mm:wax_remaining",
                                            "subject": "self",
                                            "operator": "!=",
                                            "value": 20
                                        },
                                        {
                                            "test": "has_equipment",
                                            "domain": "hand",
                                            "subject": "other",
                                            "value": "honeycomb"
                                        }
                                    ]
                                },
                                "event": "mm:wax",
                                "target": "self"
                            }
                        }
                    ]
                },
                "minecraft:environment_sensor": {
                    "triggers": [
                        {
                            "event": "mm:begin_expire",
                            "target": "self",
                            "filters": {
                                "test": "int_property",
                                "domain": "mm:wax_remaining",
                                "subject": "self",
                                "operator": "==",
                                "value": 0
                            }
                        }
                    ]
                },
                "minecraft:behavior.timer_flag_1": {
                    "cooldown_range": [
                        0,
                        0
                    ],
                    "duration_range": [
                        45,
                        60
                    ],
                    "on_start": {
                        "event": "mm:reduce_wax",
                        "target": "self"
                    },
                    "priority": 0
                },
                "minecraft:mark_variant": {
                    "value": 0
                }
            },
            "mm:default_flickerwick": {
                "minecraft:variant": {
                    "value": 0
                },
                "minecraft:loot": {
                    "table": "loot_tables/entities/flickerwick.json"
                }
            },
            "mm:soul_flickerwick": {
                "minecraft:variant": {
                    "value": 1
                },
                "minecraft:loot": {
                    "table": "loot_tables/entities/soul_flickerwick.json"
                }
            },
            "mm:copper_flickerwick": {
                "minecraft:variant": {
                    "value": 2
                },
                "minecraft:loot": {
                    "table": "loot_tables/entities/copper_flickerwick.json"
                }
            },
            "mm:sparkling_flickerwick": {
                "minecraft:variant": {
                    "value": 3
                },
                "minecraft:loot": {
                    "table": "loot_tables/entities/sparkling_flickerwick.json"
                }
            }
        },
        "components": {
            "minecraft:breathable": {
                "total_supply": 15,
                "suffocate_time": 0
            },
            "minecraft:variable_max_auto_step": {
                "base_value": 1.0625,
                "jump_prevented_value": 0.625
            },
            "minecraft:behavior.follow_owner": {
                "can_teleport": false,
                "max_distance": 64,
                "stop_distance": 2,
                "start_distance": 6,
                "priority": 1,
                "speed_multiplier": 2.6
            },
            "minecraft:behavior.tempt": {
                "items": [
                    "honeycomb"
                ],
                "within_radius": 16,
                "speed_multiplier": 1,
                "priority": 2
            },
            "minecraft:timer": {
                "looping": true,
                "time": 0.05,
                "time_down_event": {
                    "event": "mm:create_light",
                    "target": "self"
                }
            },
            "minecraft:tameable": {
                "probability": 0
            },
            "minecraft:is_hidden_when_invisible": {},
            "minecraft:experience_reward": {
                "on_death": "query.last_hit_by_player ? 3 : 0"
            },
            "minecraft:collision_box": {
                "width": 0.4,
                "height": 0.6
            },
            "minecraft:leashable": {},
            "minecraft:leashable_to": {},
            "minecraft:movement": {
                "value": 0.11
            },
            "minecraft:navigation.walk": {
                "can_path_over_water": true,
                "avoid_water": false,
                "avoid_damage_blocks": true
            },
            "minecraft:movement.basic": {},
            "minecraft:jump.static": {},
            "minecraft:can_climb": {},
            "minecraft:health": {
                "value": 20,
                "max": 20
            },
            "minecraft:follow_range": {
                "value": 1024,
                "max": 1024
            },
            "minecraft:nameable": {},
            "minecraft:despawn": {
                "despawn_from_distance": {}
            },
            "minecraft:behavior.float": {
                "priority": 0
            },
            "minecraft:behavior.random_stroll": {
                "priority": 4,
                "speed_multiplier": 1.0
            },
            "minecraft:behavior.random_look_around": {
                "priority": 5
            },
            "minecraft:type_family": {
                "family": [
                    "flickerwick",
                    "mob"
                ]
            },
            "minecraft:physics": {},
            "minecraft:pushable": {
                "is_pushable": true,
                "is_pushable_by_piston": true
            },
            "minecraft:conditional_bandwidth_optimization": {}
        },
        "events": {
            "minecraft:entity_spawned": {
                "randomize": [
                    {
                        "weight": 2,
                        "add": {
                            "component_groups": [
                                "mm:not_expired",
                                "mm:default_flickerwick",
                                "mm:size_normal"
                            ]
                        }
                    },
                    {
                        "weight": 1,
                        "add": {
                            "component_groups": [
                                "mm:not_expired",
                                "mm:default_flickerwick",
                                "mm:size_tall"
                            ]
                        }
                    }
                ]
            },
            "mm:reduce_wax": {
                "queue_command": {
                    "command": [
                        "scriptevent mm:flickerwick_melt"
                    ]
                },
                "set_property": {
                    "mm:wax_remaining": "query.property('mm:wax_remaining') - 1"
                }
            },
            "mm:begin_expire": {
                "queue_command": {
                    "command": [
                        "effect @s slowness 100 99 true"
                    ]
                },
                "add": {
                    "component_groups": [
                        "mm:expire"
                    ]
                },
                "remove": {
                    "component_groups": [
                        "mm:not_expired"
                    ]
                }
            },
            "mm:wax": {
                "queue_command": {
                    "command": [
                        "scriptevent mm:flickerwick_wax"
                    ]
                }
            },
            "mm:expire": {
                "queue_command": {
                    "command": [
                        "scriptevent mm:flickerwick_expire"
                    ]
                }
            },
            "mm:create_light": {},
            "mm:spawn_as_standard_flickerwick": {
                "add": {
                    "component_groups": [
                        "mm:default_flickerwick",
                        "mm:size_normal"
                    ]
                }
            },
            "mm:spawn_as_soul_flickerwick": {
                "add": {
                    "component_groups": [
                        "mm:soul_flickerwick",
                        "mm:size_normal"
                    ]
                }
            },
            "mm:spawn_as_copper_flickerwick": {
                "add": {
                    "component_groups": [
                        "mm:copper_flickerwick",
                        "mm:size_normal"
                    ]
                }
            },
            "mm:spawn_as_sparkling_flickerwick": {
                "add": {
                    "component_groups": [
                        "mm:sparkling_flickerwick",
                        "mm:size_normal"
                    ]
                }
            },
            "mm:spawn_as_tall_standard_flickerwick": {
                "add": {
                    "component_groups": [
                        "mm:default_flickerwick",
                        "mm:size_tall"
                    ]
                }
            },
            "mm:spawn_as_tall_soul_flickerwick": {
                "add": {
                    "component_groups": [
                        "mm:soul_flickerwick",
                        "mm:size_tall"
                    ]
                }
            },
            "mm:spawn_as_tall_copper_flickerwick": {
                "add": {
                    "component_groups": [
                        "mm:copper_flickerwick",
                        "mm:size_tall"
                    ]
                }
            },
            "mm:spawn_as_tall_sparkling_flickerwick": {
                "add": {
                    "component_groups": [
                        "mm:sparkling_flickerwick",
                        "mm:size_tall"
                    ]
                }
            },
            "mm:become_standard_flickerwick": {
                "add": {
                    "component_groups": [
                        "mm:default_flickerwick",
                        "mm:size_normal"
                    ]
                },
                "remove": {
                    "component_groups": [
                        "mm:copper_flickerwick",
                        "mm:soul_flickerwick",
                        "mm:sparkling_flickerwick"
                    ]
                }
            },
            "mm:become_soul_flickerwick": {
                "add": {
                    "component_groups": [
                        "mm:soul_flickerwick",
                        "mm:size_normal"
                    ]
                },
                "remove": {
                    "component_groups": [
                        "mm:copper_flickerwick",
                        "mm:default_flickerwick",
                        "mm:sparkling_flickerwick"
                    ]
                }
            },
            "mm:become_copper_flickerwick": {
                "add": {
                    "component_groups": [
                        "mm:copper_flickerwick",
                        "mm:size_normal"
                    ]
                },
                "remove": {
                    "component_groups": [
                        "mm:default_flickerwick",
                        "mm:soul_flickerwick",
                        "mm:sparkling_flickerwick"
                    ]
                }
            },
            "mm:become_sparkling_flickerwick": {
                "add": {
                    "component_groups": [
                        "mm:sparkling_flickerwick",
                        "mm:size_normal"
                    ]
                },
                "remove": {
                    "component_groups": [
                        "mm:default_flickerwick",
                        "mm:soul_flickerwick",
                        "mm:copper_flickerwick"
                    ]
                }
            },
            "mm:happy_face": {
                "add": {
                    "component_groups": [
                        "mm:is_happy"
                    ]
                }
            },
            "mm:standard_face": {
                "remove": {
                    "component_groups": [
                        "mm:is_happy"
                    ]
                }
            }
        }
    }
}