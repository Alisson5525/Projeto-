                "never_despawn": true,
                "radius": 2
            },
            "minecraft:timer": {
                "time": 10,
                "time_down_event": {
                    "event": "mm:despawn"
                }
            },
            "minecraft:pushable": {
                "is_pushable": false,
                "is_pushable_by_piston": true
            }
        },
        "events": {
            "mm:despawn": {
