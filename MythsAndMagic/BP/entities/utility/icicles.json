{
    "format_version": "1.21.120",
    "minecraft:entity": {
        "description": {
            "identifier": "mm:icicles",
            "is_spawnable": false,
            "is_summonable": true,
            "properties": {
                "mm:level": {
                    "default": 1,
                    "type": "int",
                    "range": [
                        1,
                        10
                    ]
                }
            }
        },
        "component_groups": {
            "mm:rising": {
                "minecraft:variant": {
                    "value": 0
                },
                "minecraft:timer": {
                    "time": 0.5,
                    "time_down_event": {
                        "event": "mm:finish_rising"
                    }
                }
            },
            "mm:stationary": {
                "minecraft:variant": {
                    "value": 0
                },
                "minecraft:timer": {
                    "time": 8.5,
                    "time_down_event": {
                        "event": "mm:sink"
                    }
                },
                "minecraft:behavior.timer_flag_1": {
                    "duration_range": [
                        0.75,
                        0.75
                    ],
                    "cooldown_range": [
                        0,
                        0
                    ],
                    "on_end": {
                        "event": "mm:emit_freeze",
                        "target": "self"
                    },
                    "priority": 0
                },
                "minecraft:is_collidable": {}
            },
            "mm:sinking": {
                "minecraft:variant": {
                    "value": 1
                },
                "minecraft:timer": {
                    "time": 1.1,
                    "time_down_event": {
                        "event": "mm:despawn"
                    }
                }
            },
            "mm:despawn": {
                "minecraft:variant": {
                    "value": 1
                },
                "minecraft:instant_despawn": {}
            }
        },
        "components": {
            "minecraft:type_family": {
                "family": [
                    "advancements:not_tameable",
                    "mm:spell"
                ]
            },
            "minecraft:scale": {
                "value": 1.5
            },
            "minecraft:loot": {
                "table": "loot_tables/empty.json"
            },
            "minecraft:collision_box": {
                "width": 0.85,
                "height": 1.45
            },
            "minecraft:health": {
                "max": 20,
                "value": 20
            },
            "minecraft:pushable": {
                "is_pushable": false,
                "is_pushable_by_piston": false
            },
            "minecraft:physics": {
                "has_gravity": false,
                "has_collision": true
            },
            "minecraft:damage_sensor": {
                "triggers": {
                    "cause": "all",
                    "deals_damage": "no"
                }
            },
            "minecraft:transient": {},
            "minecraft:knockback_resistance": {
                "max": 1.0,
                "value": 1.0
            },
            "minecraft:tameable": {
                "probability": 1
            },
            "minecraft:body_rotation_blocked": {},
            "minecraft:dimension_bound": {},
            "minecraft:reflect_projectiles": {
                "reflected_projectiles": [
                    "fishing_hook",
                    "player",
                    "experience_bottle",
                    "thrown_trident",
                    "shulker_bullet",
                    "dragon_fireball",
                    "arrow",
                    "snowball",
                    "thrownegg",
                    "fireball",
                    "splash_potion",
                    "ender_pearl",
                    "thrownenderpearl",
                    "wither_skull",
                    "small_fireball",
                    "lingering_potion",
                    "llama_spit",
                    "evocation_fang",
                    "ice_bomb",
                    "thrownicebomb"
                ],
                "azimuth_angle": "180.0 + Math.random(-5.0, 5.0)",
                "reflection_scale": "0.0625"
            },
            "minecraft:rotation_axis_aligned": {},
            "minecraft:is_collidable": {},
            "minecraft:cannot_be_attacked": {},
            "minecraft:mob_effect_immunity": {
                "mob_effects": [
                    "absorption",
                    "bad_omen",
                    "blindness",
                    "conduit_power",
                    "darkness",
                    "fatal_poison",
                    "fire_resistance",
                    "haste",
                    "health_boost",
                    "hunger",
                    "infested",
                    "instant_damage",
                    "instant_health",
                    "invisibility",
                    "fire_resistance",
                    "jump_boost",
                    "levitation",
                    "mining_fatigue",
                    "nausea",
                    "night_vision",
                    "oozing",
                    "poison",
                    "raid_omen",
                    "regeneration",
                    "resistance",
                    "saturation",
                    "slow_falling",
                    "slowness",
                    "speed",
                    "strength",
                    "trial_omen",
                    "village_hero",
                    "water_breathing",
                    "weakness",
                    "weaving",
                    "wind_charged",
                    "wither"
                ]
            },
            "minecraft:conditional_bandwidth_optimization": {}
        },
        "events": {
            "mm:emit_freeze": {},
            "minecraft:entity_spawned": {
                "add": {
                    "component_groups": [
                        "mm:rising"
                    ]
                },
                "queue_command": {
                    "command": [
                        "particle mm:icicle_snow ~~~",
                        "particle mm:icicle_snowflakes ~~~"
                    ]
                }
            },
            "mm:finish_rising": {
                "queue_command": {
                    "command": [
                        "particle mm:icicle_wind_clockwise ~~~",
                        "particle mm:icicle_wind_anticlockwise ~~~"
                    ]
                },
                "add": {
                    "component_groups": [
                        "mm:stationary"
                    ]
                },
                "remove": {
                    "component_groups": [
                        "mm:rising"
                    ]
                }
            },
            "mm:sink": {
                "add": {
                    "component_groups": [
                        "mm:sinking"
                    ]
                },
                "remove": {
                    "component_groups": [
                        "mm:stationary"
                    ]
                }
            },
            "mm:despawn": {
                "add": {
                    "component_groups": [
                        "mm:despawn"
                    ]
                }
            }
        }
    }
}