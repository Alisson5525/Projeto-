{
  "format_version": "1.21.120",
  "minecraft:entity": {
    "description": {
      "identifier": "mm:longshot_projectile",
      "runtime_identifier": "minecraft:arrow",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "mm:despawn": {
        "minecraft:instant_despawn": {}
      }
    },
    "components": {
      "minecraft:environment_sensor": {
        "triggers": [
          {
            "filters": {
              "test": "on_ground",
              "subject": "self",
              "value": true
            },
            "event": "mm:hit_ground"
          }
        ]
      },
      "minecraft:leashable": {
        "presets": [
          {
            "filter": [
              {
                "test": "on_ground",
                "value": false
              }
            ],
            "max_distance": 256,
            "hard_distance": 255,
            "soft_distance": 254,
            "spring_type": "dampened"
          },
          {
            "filter": [
              {
                "test": "on_ground",
                "value": true
              }
            ],
            "max_distance": 512,
            "hard_distance": 2,
            "soft_distance": 1,
            "spring_type": "dampened"
          }
        ]
      },
      "minecraft:collision_box": {
        "width": 0.1,
        "height": 0.1
      },
      "minecraft:body_rotation_always_follows_head": {},
      "minecraft:projectile": {
        "on_hit": {
          "stick_in_ground": {
            "shake_time": 0.1
          },
          "impact_damage": {
            "damage": 5,
            "knockback": true
          }
        },
        "power": 1.05,
        "gravity": 0.02,
        "inertia": 1,
        "liquid_inertia": 0.99,
        "anchor": 2,
        "offset": [
          0,
          0.5,
          0
        ],
        "semi_random_diff_damage": true,
        "uncertainty_base": 0,
        "reflect_on_hurt": true
      },
      "minecraft:transient": {},
      "minecraft:physics": {
        "has_collision": true
      },
      "minecraft:timer": {
        "looping": false,
        "time": 300,
        "time_down_event": {
          "event": "mm:despawn"
        }
      },
      "minecraft:tick_world": {},
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:conditional_bandwidth_optimization": {
        "default_values": {
          "max_optimized_distance": 80,
          "max_dropped_ticks": 7,
          "use_motion_prediction_hints": true
        }
      }
    },
    "events": {
      "mm:hit_ground": {},
      "mm:despawn": {
        "add": {
          "component_groups": [
            "mm:despawn"
          ]
        }
