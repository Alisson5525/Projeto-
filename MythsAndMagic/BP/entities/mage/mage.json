{
    "format_version": "1.21.120",
    "minecraft:entity": {
        "description": {
            "identifier": "mm:mage",
            "spawn_category": "creature",
            "is_spawnable": true,
            "is_summonable": true,
            "properties": {
                "mm:using_crystal": {
                    "client_sync": true,
                    "default": false,
                    "type": "bool"
                },
                "mm:hiding": {
                    "client_sync": true,
                    "default": false,
                    "type": "bool"
                }
            }
        },
        "component_groups": {
            "mm:hide_timer": {
                "minecraft:attack_cooldown": {
                    "attack_cooldown_time": 5,
                    "attack_cooldown_complete_event": {
                        "event": "mm:hide_cooldown_end",
                        "target": "self"
                    }
                }
            },
            "mm:use_crystal_timer": {
                "minecraft:timer": {
                    "time": 5,
                    "time_down_event": {
                        "event": "mm:finish_crystal_use",
                        "target": "self"
                    }
                }
            },
            "mm:spellcrafter_broken": {
                "minecraft:is_shaking": {},
                "minecraft:behavior.timer_flag_1": {
                    "duration_range": 10,
                    "cooldown_range": 0,
                    "on_end": {
                        "event": "mm:finish_spellcrafter_broken",
                        "target": "self"
                    }
                }
            },
            "mm:hiding_under_hat": {
                "minecraft:entity_sensor": {
                    "subsensors": [
                        {
                            "cooldown": 4,
                            "range": [
                                12,
                                4
                            ],
                            "maximum_count": 0,
                            "minimum_count": 0,
                            "event_filters": [
                                {
                                    "all_of": [
                                        {
                                            "test": "was_last_hurt_by",
                                            "subject": "other"
                                        }
                                    ]
                                }
                            ],
                            "event": "mm:finish_hiding"
                        }
                    ]
                },
                "minecraft:movement": {
                    "value": 0.0
                },
                "minecraft:body_rotation_blocked": {},
                "minecraft:collision_box": {
                    "height": 1.2,
                    "width": 0.65
                },
                "minecraft:pushable": {
                    "is_pushable": false,
                    "is_pushable_by_piston": true
                },
                "minecraft:damage_sensor": {
                    "triggers": [
                        {
                            "cause": "fall",
                            "deals_damage": "no"
                        },
                        {
                            "cause": "all",
                            "damage_modifier": -6
                        }
                    ]
                },
                "minecraft:knockback_resistance": {
                    "max": 1.0,
                    "value": 1.0
                }
            },
            "mm:not_hiding": {
                "minecraft:movement": {
                    "value": 0.33
                },
                "minecraft:behavior.float": {
                    "priority": 0
                },
                "minecraft:behavior.random_stroll": {
                    "priority": 6,
                    "speed_multiplier": 1
                },
                "minecraft:navigation.walk": {
                    "can_path_over_water": true,
                    "avoid_water": true,
                    "avoid_damage_blocks": true
                },
                "minecraft:movement.basic": {},
                "minecraft:jump.static": {},
                "minecraft:collision_box": {
                    "width": 0.65,
                    "height": 3
                },
                "minecraft:pushable": {
                    "is_pushable": true,
                    "is_pushable_by_piston": true
                },
                "minecraft:damage_sensor": {
                    "triggers": [
                        {
                            "cause": "all",
                            "on_damage": {
                                "event": "mm:hide_under_hat",
                                "filters": [
                                    {
                                        "all_of": [
                                            {
                                                "test": "is_family",
                                                "subject": "other",
                                                "value": "player"
                                            },
                                            {
                                                "test": "has_component",
                                                "subject": "self",
                                                "value": "minecraft:attack_cooldown",
                                                "operator": "!="
                                            },
                                            {
                                                "test": "is_difficulty",
                                                "operator": "not",
                                                "value": "peaceful"
                                            }
                                        ]
                                    }
                                ]
                            }
                        },
                        {
                            "cause": "fall",
                            "deals_damage": "no"
                        }
                    ]
                },
                "minecraft:knockback_resistance": {
                    "max": 0.0,
                    "value": 0.0
                }
            }
        },
        "components": {
            "minecraft:interact": {
                "interactions": [
                    {
                        "on_interact": {
                            "filters": [
                                {
                                    "all_of": [
                                        {
                                            "test": "has_equipment",
                                            "subject": "other",
                                            "value": "mm:sparkling_crystal"
                                        },
                                        {
                                            "test": "bool_property",
                                            "domain": "mm:hiding",
                                            "value": false
                                        },
                                        {
                                            "test": "bool_property",
                                            "domain": "mm:using_crystal",
                                            "value": false
                                        }
                                    ]
                                }
                            ],
                            "event": "mm:use_crystal"
                        },
                        "cooldown": 2,
                        "cooldown_after_being_attacked": 2,
                        "interact_text": "action.interact.mage",
                        "use_item": true
                    },
                    {
                        "on_interact": {
                            "filters": [
                                {
                                    "all_of": [
                                        {
                                            "test": "has_equipment",
                                            "subject": "other",
                                            "operator": "!=",
                                            "value": "mm:sparkling_crystal"
                                        },
                                        {
                                            "test": "has_equipment",
                                            "subject": "other",
                                            "operator": "!=",
                                            "value": "air"
                                        },
                                        {
                                            "test": "bool_property",
                                            "domain": "mm:hiding",
                                            "value": false
                                        },
                                        {
                                            "test": "bool_property",
                                            "domain": "mm:using_crystal",
                                            "value": false
                                        }
                                    ]
                                }
                            ],
                            "event": "mm:refuse_item"
                        },
                        "cooldown": 2,
                        "cooldown_after_being_attacked": 2,
                        "interact_text": "action.interact.mage"
                    }
                ]
            },
            "minecraft:behavior.panic": {
                "priority": 1,
                "speed_multiplier": 1.25
            },
            "minecraft:experience_reward": {
                "on_death": "query.last_hit_by_player ? Math.Random(1,3) : 0"
            },
            "minecraft:is_hidden_when_invisible": {},
            "minecraft:type_family": {
                "family": [
                    "mage",
                    "mob"
                ]
            },
            "minecraft:home": {
                "restriction_radius": 16,
                "restriction_type": "random_movement"
            },
            "minecraft:breathable": {
                "total_supply": 15,
                "suffocate_time": 0
            },
            "minecraft:can_climb": {},
            "minecraft:nameable": {},
            "minecraft:health": {
                "value": 30,
                "max": 30
            },
            "minecraft:hurt_on_condition": {
                "damage_conditions": [
                    {
                        "filters": {
                            "test": "in_lava",
                            "subject": "self",
                            "operator": "==",
                            "value": true
                        },
                        "cause": "lava",
                        "damage_per_tick": 4
                    }
                ]
            },
            "minecraft:behavior.look_at_player": {
                "priority": 7,
                "look_distance": 6.0,
                "probability": 0.02
            },
            "minecraft:loot": {
                "table": "loot_tables/entities/mage.json"
            },
            "minecraft:behavior.random_look_around": {
                "priority": 9
            },
            "minecraft:persistent": {},
            "minecraft:balloonable": {},
            "minecraft:physics": {},
            "minecraft:conditional_bandwidth_optimization": {}
        },
        "events": {
            "minecraft:entity_spawned": {
                "add": {
                    "component_groups": [
                        "mm:not_hiding"
                    ]
                }
            },
            "mm:mage_release_the_gang": {},
            "mm:finish_spellcrafter_broken": {
                "remove": {
                    "component_groups": [
                        "mm:spellcrafter_broken"
                    ]
                }
            },
            "mm:spellcrafter_broken": {
                "trigger": "mm:mage_release_the_gang",
                "stop_movement": {
                    "stop_horizontal_movement": true,
                    "stop_vertical_movement": false
                },
                "queue_command": {
                    "command": [
                        "effect @s slowness 3 99 true"
                    ]
                },
                "set_property": {
                    "mm:hiding": true
                },
                "add": {
                    "component_groups": [
                        "mm:hiding_under_hat",
                        "mm:spellcrafter_broken"
                    ]
                },
                "remove": {
                    "component_groups": [
                        "mm:not_hiding",
                        "mm:hide_timer"
                    ]
                }
            },
            "mm:refuse_item": {
                "queue_command": {
                    "command": [
                        "playanimation @s animation.mage.shake_head"
                    ]
                }
            },
            "mm:use_crystal": {
                "stop_movement": {
                    "stop_horizontal_movement": true,
                    "stop_vertical_movement": false
                },
                "queue_command": {
                    "command": [
                        "effect @s slowness 5 99 true"
                    ]
                },
                "add": {
                    "component_groups": [
                        "mm:use_crystal_timer"
                    ]
                },
                "set_property": {
                    "mm:using_crystal": true
                }
            },
            "mm:finish_crystal_use": {
                "set_property": {
                    "mm:using_crystal": false
                },
                "remove": {
                    "component_groups": [
                        "mm:use_crystal_timer"
                    ]
                }
            },
            "mm:hide_under_hat": {
                "trigger": "mm:mage_release_the_gang",
                "stop_movement": {
                    "stop_horizontal_movement": true,
                    "stop_vertical_movement": false
                },
                "queue_command": {
                    "command": [
                        "effect @s slowness 3 99 true"
                    ]
                },
                "set_property": {
                    "mm:hiding": true
                },
                "add": {
                    "component_groups": [
                        "mm:hiding_under_hat"
                    ]
                },
                "remove": {
                    "component_groups": [
                        "mm:not_hiding",
                        "mm:hide_timer"
                    ]
                }
            },
            "mm:finish_hiding": {
                "set_property": {
                    "mm:hiding": false
                },
                "remove": {
                    "component_groups": [
                        "mm:hiding_under_hat"
                    ]
                },
                "add": {
                    "component_groups": [
                        "mm:not_hiding",
                        "mm:hide_timer"
                    ]
                }
            },
            "mm:hide_cooldown_end": {
                "remove": {
                    "component_groups": [
                        "mm:hide_timer"
                    ]
                }
            }
        }
    }
}