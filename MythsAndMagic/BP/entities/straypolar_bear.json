          },
          {
            "cause": "freezing",
            "deals_damage": "no"
          }
        ]
      },
      "minecraft:is_hidden_when_invisible": {},
      "minecraft:type_family": {
        "family": [
          "longshot_heavy",
          "stray_polar_bear",
          "undead",
          "mob"
        ]
      },
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0,
        "breathes_air": true,
        "breathes_water": true
      },
      "minecraft:nameable": {},
      "minecraft:health": {
        "value": 30
      },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": {
              "test": "in_lava",
              "subject": "self",
              "operator": "==",
              "value": true
            },
            "cause": "lava",
            "damage_per_tick": 4
          }
        ]
      },
      "minecraft:collision_box": {
        "width": 1.4,
        "height": 1.4
      },
