            "mm:stray_polarbear_with_hostile_rider"
          ]
        },
        "remove": {
          "component_groups": [
            "mm:stray_polarbear_no_rider",
            "mm:stray_polarbear_with_no_hostile_rider"
          ]
        },
        "set_property": {
          "minecraft:has_rider_mounted": true
        }
      },
      "mm:stray_polarbear_saddled": {
        "add": {
          "component_groups": [
            "mm:stray_polarbear_saddled"
          ]
        },
        "remove": {
          "component_groups": [
            "mm:stray_polarbear_burn_in_day"
          ]
        }
      },
      "mm:stray_polarbear_unsaddled": {
        "add": {
          "component_groups": [
            "mm:stray_polarbear_burn_in_day"
          ]
        },
        "remove": {
          "component_groups": [
            "mm:stray_polarbear_saddled"
          ]
        }
      },
      "minecraft:all_riders_dismounted": {
        "add": {
          "component_groups": [
            "mm:stray_polarbear_no_rider",
            "mm:stray_polarbear_with_no_hostile_rider"
          ]
        },
        "remove": {
          "component_groups": [
            "mm:stray_polarbear_with_hostile_rider"
          ]
        },
        "set_property": {
          "minecraft:has_rider_mounted": false
        }
      },
      "minecraft:rider_mounted": {
        "remove": {
          "component_groups": [
            "mm:stray_polarbear_no_rider"
          ]
        },
        "set_property": {
          "minecraft:has_rider_mounted": true
        }
      },
      "minecraft:entity_born": {
        "add": {
          "component_groups": [
            "mm:stray_polarbear_burn_in_day",
            "minecraft:baby",
            "mm:stray_polarbear_no_rider",
            "mm:stray_polarbear_with_no_hostile_rider"
          ]
        }
      },
      "minecraft:ageable_grow_up": {
        "remove": {
          "component_groups": [
            "minecraft:baby"
          ]
        },
        "add": {
          "component_groups": [
            "minecraft:adult"
          ]
        }
      }
