{
    "format_version": "1.21.90",
    "minecraft:entity": {
        "description": {
            "identifier": "mm:sacred_statue",
            "spawn_category": "monster",
            "is_spawnable": true,
            "is_summonable": true
        },
        "component_groups": {
            "mm:statue": {
                "minecraft:is_collidable": {},
                "minecraft:damage_sensor": {
                    "triggers": [
                        {
                            "cause": "all",
                            "deals_damage": "no"
                        }
                    ]
                }
            },
            "mm:slam_cooldown": {
                "minecraft:attack_cooldown": {
                    "attack_cooldown_time": 8,
                    "attack_cooldown_complete_event": {
                        "event": "mm:statue_slam_attack_cooldown_finished",
                        "target": "self"
                    }
                }
            },
            "mm:slam_attack": {
                "minecraft:body_rotation_blocked": {},
                "minecraft:behavior.delayed_attack": {
                    "attack_duration": 1,
                    "cooldown_time": 0.9,
                    "hit_delay_pct": 0.38,
                    "priority": 1,
                    "speed_multiplier": 0.0,
                    "sound_event": "attack",
                    "reach_multiplier": 0
                },
                "minecraft:entity_sensor": {},
                "minecraft:timer": {
                    "randomInterval": true,
                    "time": [
                        3.2,
                        4
                    ],
                    "looping": true,
                    "time_down_event": {
                        "event": "mm:statue_slam_attack_finish",
                        "target": "self"
                    }
                }
            },
            "mm:charge_slam_attack": {
                "minecraft:behavior.delayed_attack": {
                    "attack_duration": 1,
                    "cooldown_time": 0.9,
                    "hit_delay_pct": 0.38,
                    "priority": 1,
                    "speed_multiplier": 1.3,
                    "sound_event": "attack",
                    "reach_multiplier": 0
                },
                "minecraft:entity_sensor": {},
                "minecraft:timer": {
                    "time": 1.5,
                    "looping": true,
                    "time_down_event": {
                        "event": "mm:statue_slam_attack",
                        "target": "self"
                    }
                }
            },
            "mm:normal_attacking": {
                "minecraft:behavior.delayed_attack": {
                    "attack_duration": 1,
                    "cooldown_time": 1.9,
                    "hit_delay_pct": 0.38,
                    "priority": 1,
                    "speed_multiplier": 1.2,
                    "sound_event": "attack",
                    "reach_multiplier": 2.5
                },
                "minecraft:entity_sensor": {
                    "subsensors": [
                        {
                            "minimum_count": 1,
                            "range": [
                                5,
                                5
                            ],
                            "cooldown": 5,
                            "event_filters": [
                                {
                                    "test": "is_target",
                                    "value": true,
                                    "subject": "other"
                                },
                                {
                                    "test": "has_component",
                                    "value": "minecraft:attack_cooldown",
                                    "operator": "!="
                                }
                            ],
                            "event": "mm:statue_charge_slam_attack"
                        }
                    ]
                }
            },
            "mm:alive": {
                "minecraft:variable_max_auto_step": {
                    "base_value": 1.0625,
                    "controlled_value": 1.0625,
                    "jump_prevented_value": 0.5625
                },
                "minecraft:type_family": {
                    "family": [
                    "longshot_unpullable",
                        "sacred_statue",
                        "monster",
                        "mob"
                    ]
                },
                "minecraft:damage_sensor": {
                    "triggers": [
                        {
                            "cause": "entity_attack",
                            "on_damage": {
                                "filters": [
                                    {
                                        "any_of": [
                                            {
                                                "test": "has_equipment_tag",
                                                "value": "minecraft:is_pickaxe",
                                                "subject": "other",
                                                "operator": "not"
                                            }
                                        ]
                                    }
                                ],
                                "event": "mm:damaged_by_wrong_tool"
                            },
                            "damage_multiplier": 0.1,
                            "deals_damage": "yes"
                        },
                        {
                            "cause": "entity_attack",
                            "on_damage": {
                                "filters": [
                                    {
                                        "any_of": [
                                            {
                                                "test": "has_equipment_tag",
                                                "value": "minecraft:is_pickaxe",
                                                "subject": "other",
                                                "operator": "=="
                                            }
                                        ]
                                    }
                                ],
                                "event": "mm:damaged_by_right_tool"
                            },
                            "damage_multiplier": 1,
                            "deals_damage": "yes"
                        },
                        {
                            "cause": "block_explosion",
                            "damage_multiplier": 0.75,
                            "deals_damage": "yes"
                        },
                        {
                            "cause": "entity_explosion",
                            "damage_multiplier": 0.75,
                            "deals_damage": "yes"
                        },
                        {
                            "cause": "fall",
                            "deals_damage": "no"
                        },
                        {
                            "cause": "magic",
                            "deals_damage": "no"
                        },
                        {
                            "cause": "all",
                            "deals_damage": "yes",
                            "damage_multiplier": 0.1
                        }
                    ]
                },
                "minecraft:behavior.hurt_by_target": {
                    "priority": 1
                },
                "minecraft:behavior.nearest_attackable_target": {
                    "priority": 2,
                    "must_see": true,
                    "entity_types": [
                        {
                            "filters": {
                                "test": "is_family",
                                "subject": "other",
                                "value": "player"
                            },
                            "max_dist": 32.0
                        }
                    ]
                },
                "minecraft:navigation.walk": {
                    "can_sink": true,
                    "can_path_over_water": true,
                    "avoid_water": true,
                    "avoid_damage_blocks": true
                },
                "minecraft:movement.basic": {},
                "minecraft:jump.static": {},
                "minecraft:can_climb": {},
                "minecraft:attack": {
                    "damage": 12
                },
                "minecraft:behavior.random_stroll": {
                    "priority": 4,
                    "speed_multiplier": 1.0
                }
            }
        },
        "components": {
            "minecraft:reflect_projectiles": {
                "reflected_projectiles": [
                    "fishing_hook",
                    "experience_bottle",
                    "thrown_trident",
                    "shulker_bullet",
                    "dragon_fireball",
                    "arrow",
                    "snowball",
                    "thrownegg",
                    "fireball",
                    "splash_potion",
                    "ender_pearl",
                    "thrownenderpearl",
                    "wither_skull",
                    "small_fireball",
                    "lingering_potion",
                    "llama_spit",
                    "evocation_fang",
                    "ice_bomb",
                    "thrownicebomb"
                ],
                "azimuth_angle": "180.0 + Math.random(-5.0, 5.0)",
                "reflection_scale": "0.0625"
            },
            "minecraft:fire_immune": true,
            "minecraft:knockback_resistance": {
                "value": 1.0
            },
            "minecraft:collision_box": {
                "width": 1.2,
                "height": 4.3
            },
            "minecraft:is_hidden_when_invisible": {},
            "minecraft:experience_reward": {
                "on_death": "query.last_hit_by_player ? 50 : 0"
            },
            "minecraft:loot": {
                "table": "loot_tables/entities/sacred_statue.json"
            },
            "minecraft:movement": {
                "value": 0.2
            },
            "minecraft:health": {
                "value": 150,
                "max": 150
            },
            "minecraft:follow_range": {
                "value": 48,
                "max": 48
            },
            "minecraft:nameable": {},
            "minecraft:physics": {},
            "minecraft:conditional_bandwidth_optimization": {}
        },
        "events": {
            "mm:statue_charge_slam_attack": {
                "queue_command": {
                    "command": [
                        "playanimation @s animation.sacred_statue.charge_slam_attack"
                    ]
                },
                "add": {
                    "component_groups": [
                        "mm:charge_slam_attack"
                    ]
                },
                "remove": {
                    "component_groups": [
                        "mm:normal_attacking"
                    ]
                }
            },
            "mm:statue_slam_attack": {
                "queue_command": {
                    "command": [
                        "playanimation @s animation.sacred_statue.large_attack",
                        "effect @s slowness 3 255 true"
                        //check scripts for attack code
                    ]
                },
                "add": {
                    "component_groups": [
                        "mm:slam_attack"
                    ]
                },
                "remove": {
                    "component_groups": [
                        "mm:charge_slam_attack",
                        "mm:normal_attacking"
                    ]
                }
            },
            "mm:statue_slam_attack_finish": {
                "add": {
                    "component_groups": [
                        "mm:normal_attacking",
                        "mm:slam_cooldown"
                    ]
                },
                "remove": {
                    "component_groups": [
                        "mm:slam_attack"
                    ]
                }
            },
            "mm:statue_slam_attack_cooldown_finished": {
                "remove": {
                    "component_groups": [
                        "mm:slam_cooldown"
                    ]
                }
            },
            "mm:damaged_by_right_tool": {
                "queue_command": {
                    "command": [
                        "effect @s speed 1 0 true",
                        "particle mm:statue_hit_correct_tool ~~1~",
                        "playsound mob.sacred_statue.critical_hurt @a ~~~"
                    ]
                }
            },
            "mm:damaged_by_wrong_tool": {},
            "minecraft:entity_spawned": {
                "add": {
                    "component_groups": [
                        "mm:alive",
                        "mm:normal_attacking"
                    ]
                }
            },
            "mm:spawn_statue": {
                "add": {
                    "component_groups": [
                        "mm:statue"
                    ]
                }
            },
            "mm:wake_up": {
                "queue_command": {
                    "command": [
                        "playsound mob.mymik.wake_up @a ~~~ 0 1",
                        "playanimation @s animation.sacred_statue.awaken"
                    ]
                },
                "remove": {
                    "component_groups": [
                        "mm:statue"
                    ]
                },
                "add": {
                    "component_groups": [
                        "mm:alive",
                        "mm:normal_attacking"
                    ]
                }
            }
        }
    }
}