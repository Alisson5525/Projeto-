                "look_distance": 6.0,
                "probability": 0.02
            },
            "minecraft:behavior.random_look_around": {
                "priority": 9
            },
            "minecraft:balloonable": {},
            "minecraft:physics": {},
            "minecraft:pushable": {
                "is_pushable": true,
                "is_pushable_by_piston": true
            },
            "minecraft:conditional_bandwidth_optimization": {}
        },
        "events": {
            "mm:grow_up": {
                "add": {
                    "component_groups": [
                        "mm:adult",
                        "mm:can_pickup_items"
                    ]
                },
                "remove": {
                    "component_groups": [
                        "mm:baby"
                    ]
                }
            },
            "minecraft:entity_born": {
                "randomize": [
                    {
                        "set_property": {
                            "mm:legacy_updated": true
                        },
                        "add": {
                            "component_groups": [
                                "mm:baby",
                                "mm:tamed",
                                "mm:flowered"
                            ]
                        },
                        "weight": 1
                    },
                    {
                        "set_property": {
                            "mm:legacy_updated": true
                        },
                        "add": {
                            "component_groups": [
                                "mm:baby",
                                "mm:tamed",
                                "mm:not_flowered"
                            ]
                        },
                        "weight": 9
                    }
                ]
            },
            "mm:held_item_removed": {
                "set_property": {
                    "mm:holding_item": false
                }
            },
            "mm:held_item_gained": {
                "set_property": {
                    "mm:holding_item": true
                }
            },
            "mm:drop_item": {},
            "mm:stored_item": {
                "add": {
                    "component_groups": [
                        "mm:pickup_items_cooldown"
                    ]
                },
                "remove": {
                    "component_groups": [
                        "mm:can_pickup_items"
                    ]
                }
            },
            "mm:can_pickup_items": {
                "add": {
                    "component_groups": [
                        "mm:can_pickup_items"
                    ]
                },
                "remove": {
                    "component_groups": [
                        "mm:pickup_items_cooldown"
                    ]
                }
            },
            "mm:has_melee_weapon": {
                "add": {
                    "component_groups": [
                        "mm:holding_melee_weapon"
                    ]
                },
                "remove": {
                    "component_groups": [
                        "mm:not_holding_melee_weapon"
                    ]
                }
            },
            "mm:no_melee_weapon": {
                "add": {
                    "component_groups": [
                        "mm:not_holding_melee_weapon"
                    ]
                },
                "remove": {
                    "component_groups": [
                        "mm:holding_melee_weapon"
                    ]
                }
            },
            "mm:sheared": {
                "remove": {
                    "component_groups": [
                        "mm:flowered"
                    ]
                },
                "add": {
                    "component_groups": [
                        "mm:not_flowered"
                    ]
                }
            },
            "mm:spawn_flowered": {
                "set_property": {
                    "mm:legacy_updated": true
                },
                "add": {
                    "component_groups": [
                        "mm:adult",
                        "mm:untamed",
                        "mm:flowered",
                        "mm:can_pickup_items"
                    ]
                }
            },
            "mm:spawn_default": {
                "set_property": {
                    "mm:legacy_updated": true
                },
                "add": {
                    "component_groups": [
                        "mm:adult",
                        "mm:untamed",
                        "mm:not_flowered",
                        "mm:can_pickup_items"
                    ]
                }
            },
            "minecraft:entity_spawned": {
                "set_property": {
                    "mm:legacy_updated": true
                },
                "randomize": [
                    {
                        "add": {
                            "component_groups": [
                                "mm:flowered",
                                "mm:untamed",
                                "mm:can_pickup_items",
                                "mm:adult"
                            ]
                        },
                        "weight": 9
                    },
                    {
                        "add": {
                            "component_groups": [
                                "mm:not_flowered",
                                "mm:untamed",
                                "mm:can_pickup_items",
                                "mm:adult"
                            ]
                        },
                        "weight": 6
                    },
                    {
                        "add": {
                            "component_groups": [
                                "mm:not_flowered",
                                "mm:untamed",
                                "mm:baby"
                            ]
                        },
                        "weight": 1
                    }
                ]
            },
            "mm:tamed": {
                "add": {
                    "component_groups": [
                        "mm:tamed"
                    ]
                },
                "remove": {
                    "component_groups": [
                        "mm:untamed",
                        "mm:pickup_items_cooldown"
                    ]
                }
            },
            "mm:update_legacy": {
                "queue_command": {
                    "command": [
                        "tag @s add mm:legacy_updated_mm:scrubel"
                    ]
                },
                "set_property": {
                    "mm:legacy_updated": true
                },
                "add": {
                    "component_groups": [
                        "mm:adult"
                    ]
                }
            }
        }
    }
}