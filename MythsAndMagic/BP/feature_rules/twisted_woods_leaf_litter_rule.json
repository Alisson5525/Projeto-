{
    "format_version": "1.13.0",
    "minecraft:feature_rules": {
        "description": {
            "identifier": "mm:twisted_woods_leaf_litter_rule",
            "places_feature": "minecraft:scatter_leaf_litter_feature"
        },
        "conditions": {
            "placement_pass": "after_surface_pass",
            "minecraft:biome_filter": [
                {
                    "test": "has_biome_tag",
                    "value": "twisted_woods"
                }
            ]
        },
        "distribution": {
            "iterations": 4,
            "scatter_chance": {
                "numerator": 1,
                "denominator": 3
            },
            "x": {
                "distribution": "uniform",
                "extent": [
                    0,
                    16
                ]
            },
            "y": "query.heightmap(variable.worldx, variable.worldz)",
            "z": {
                "distribution": "uniform",
                "extent": [
                    0,
                    16
                ]
            }
        }
    }
}