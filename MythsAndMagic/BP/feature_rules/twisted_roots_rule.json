{
    "format_version": "1.13.0",
    "minecraft:feature_rules": {
        "description": {
            "identifier": "mm:twisted_roots_rule",
            "places_feature": "mm:twisted_roots_feature"
        },
        "conditions": {
            "placement_pass": "before_surface_pass",
            "minecraft:biome_filter": [
                {
                    "test": "has_biome_tag",
                    "operator": "==",
                    "value": "twisted_woods"
                }
            ]
        },
        "distribution": {
            "iterations": 1000,
            "scatter_chance": {
                "numerator": 1,
                "denominator": 4
            },
            "coordinate_eval_order": "zxy",
            "x": {
                "distribution": "uniform",
                "extent": [
                    0,
                    16
                ]
            },
            "y": {
                "distribution": "uniform",
                "extent": [
                    60,
                    "math.clamp(query.heightmap(variable.worldx, variable.worldz)+3,61,query.heightmap(variable.worldx, variable.worldz)+3)"
                ]
            },
            "z": {
                "distribution": "uniform",
                "extent": [
                    0,
                    16
                ]
            }
        }
    }
}