{
    "format_version": "1.26.0",
    "minecraft:block": {
        "description": {
            "identifier": "mm:magnetic_piston",
            "menu_category": {
                "category": "items"
            },
            "traits": {
                "minecraft:placement_position": {
                    "enabled_states": [
                        "minecraft:block_face"
                    ]
                }
            },
            "states": {
                "mm:state": [
                    "orange",
                    "blue"
                ],
                "mm:powered": [
                    false,
                    true
                ]
            }
        },
        "permutations": [
            {
                "condition": "query.block_state('mm:powered') == false && query.block_state('mm:state') == 'orange'",
                "components": {
                    "minecraft:material_instances": {
                        "up": {
                            "texture": "magnetic_piston_top_off",
                            "render_method": "alpha_test"
                        },
                        "*": {
                            "texture": "magnetic_piston_side_off",
                            "render_method": "alpha_test"
                        },
                        "down": {
                            "texture": "magnetic_piston_bottom_orange",
                            "render_method": "alpha_test"
                        }
                    }
                }
            },
            {
                "condition": "query.block_state('mm:powered') == true && query.block_state('mm:state') == 'orange'",
                "components": {
                    "minecraft:material_instances": {
                        "up": {
                            "texture": "magnetic_piston_top_orange",
                            "render_method": "alpha_test"
                        },
                        "*": {
                            "texture": "magnetic_piston_side_orange",
                            "render_method": "alpha_test"
                        },
                        "down": {
                            "texture": "magnetic_piston_bottom_orange",
                            "render_method": "alpha_test"
                        }
                    }
                }
            },
            {
                "condition": "query.block_state('mm:powered') == false && query.block_state('mm:state') == 'blue'",
                "components": {
                    "minecraft:material_instances": {
                        "up": {
                            "texture": "magnetic_piston_top_off",
                            "render_method": "alpha_test"
                        },
                        "*": {
                            "texture": "magnetic_piston_side_off",
                            "render_method": "alpha_test"
                        },
                        "down": {
                            "texture": "magnetic_piston_bottom_blue",
                            "render_method": "alpha_test"
                        }
                    }
                }
            },
            {
                "condition": "query.block_state('mm:powered') == true && query.block_state('mm:state') == 'blue'",
                "components": {
                    "minecraft:material_instances": {
                        "up": {
                            "texture": "magnetic_piston_top_blue",
                            "render_method": "alpha_test"
                        },
                        "*": {
                            "texture": "magnetic_piston_side_blue",
                            "render_method": "alpha_test"
                        },
                        "down": {
                            "texture": "magnetic_piston_bottom_blue",
                            "render_method": "alpha_test"
                        }
                    }
                }
            },
            {
                "condition": "query.block_state('minecraft:block_face') == 'up'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            0,
                            0,
                            0
                        ]
                    }
                }
            },
            {
                "condition": "query.block_state('minecraft:block_face') == 'north'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            -90,
                            0,
                            0
                        ]
                    }
                }
            },
            {
                "condition": "query.block_state('minecraft:block_face') == 'south'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            90,
                            0,
                            0
                        ]
                    }
                }
            },
            {
                "condition": "query.block_state('minecraft:block_face') == 'east'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            0,
                            0,
                            -90
