{
    "format_version": "1.26.10",
    "minecraft:block": {
        "description": {
            "identifier": "mm:twisted_fence_gate",
            "menu_category": {
                "is_hidden_in_commands": true,
                "category": "construction"
            },
            "states": {
                "mm:closed": [
                    true,
                    false
                ],
                "mm:open_away": [
                    true,
                    false
                ]
            },
            "traits": {
                "minecraft:placement_direction": {
                    "enabled_states": [
                        "minecraft:cardinal_direction"
                    ]
                }
            }
        },
        "components": {
            "tag:minecraft:is_axe_item_destructible": {},
            "tag:axe_mine": {},
            "minecraft:material_instances": {
                "*": {
                    "texture": "twisted_planks"
                }
            },
            "minecraft:redstone_conductivity": {
                "redstone_conductor": true
            },
            "minecraft:redstone_consumer": {
                "min_power": 0,
                "propogates_power": true
            },
            "minecraft:flammable": true,
            "minecraft:map_color": "#E896F9",
            "minecraft:destructible_by_mining": {
                "seconds_to_destroy": 2
            },
            "minecraft:destructible_by_explosion": {
                "explosion_resistance": 3
            },
            "mm:fence_gate": {
                "open_sound": "open.nether_wood_fence_gate",
                "close_sound": "close.nether_wood_fence_gate"
            },
            "minecraft:geometry": {
                "identifier": "geometry.mm_fence_gate",
                "bone_visibility": {
                    "posts": true,
                    "gate_closed": "q.block_state('mm:closed')",
                    "gate_open": "!q.block_state('mm:closed') && !q.block_state('mm:open_away')",
                    "gate_open_reverse": "!q.block_state('mm:closed') && q.block_state('mm:open_away')"
                }
            },
            "minecraft:connection_rule": {
                "accepts_connections_from": "only_fences"
            },
            "minecraft:support": {
                "shape": "fence"
            },
            "minecraft:collision_box": {
                "origin": [
                    -8,
                    0,
                    -2
                ],
                "size": [
                    16,
                    24,
                    4
                ]
            },
            "minecraft:selection_box": {
                "origin": [
                    -8,
                    0,
                    -2
                ],
                "size": [
                    16,
                    16,
                    4
                ]
            },
            "minecraft:liquid_detection": {
                "detection_rules": [
                    {
                        "liquid_type": "water",
                        "can_contain_liquid": true,
                        "on_liquid_touches": "blocking"
                    }
                ]
            }
        },
        "permutations": [
            {
                "condition": "q.block_state('minecraft:cardinal_direction') == 'north'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            0,
                            180,
                            0
                        ]
                    },
                    "minecraft:connection_rule": {
                        "accepts_connections_from": "only_fences",
                        "enabled_directions": [
                            "east",
                            "west"
                        ]
                    }
                }
            },
            {
                "condition": "q.block_state('minecraft:cardinal_direction') == 'south'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            0,
                            0,
                            0
                        ]
                    },
                    "minecraft:connection_rule": {
                        "accepts_connections_from": "only_fences",
                        "enabled_directions": [
                            "east",
                            "west"
                        ]
                    }
                }
            },
            {
                "condition": "q.block_state('minecraft:cardinal_direction') == 'east'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            0,
                            90,
                            0
                        ]
                    },
                    "minecraft:connection_rule": {
                        "accepts_connections_from": "only_fences",
                        "enabled_directions": [
                            "north",
                            "south"
                        ]
                    }
                }
            },
            {
                "condition": "q.block_state('minecraft:cardinal_direction') == 'west'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            0,
                            270,
                            0
                        ]
                    },
                    "minecraft:connection_rule": {
                        "accepts_connections_from": "only_fences",
                        "enabled_directions": [
                            "north",
                            "south"
                        ]
                    }
                }
            },
            {
                "condition": "q.block_state('mm:closed')",
                "components": {
                    "minecraft:collision_box": {
                        "origin": [
                            -8,
                            0,
                            -2
                        ],
                        "size": [
                            16,
                            24,
                            4
                        ]
                    }
                }
            },
            {
                "condition": "!q.block_state('mm:closed')",
                "components": {
                    "minecraft:collision_box": false
                }
            }
        ]
    }
}