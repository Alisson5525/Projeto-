{
    "format_version": "1.21.130",
    "minecraft:block": {
        "description": {
            "identifier": "mm:twisted_pressure_plate",
            "menu_category": {
                "category": "construction"
            },
            "states": {
                "mm:pressed": [
                    false,
                    true
                ]
            }
        },
        "permutations": [
            {
                "condition": "query.block_state('mm:pressed')",
                "components": {
                    "minecraft:selection_box": {
                        "origin": [
                            -7,
                            0,
                            -7
                        ],
                        "size": [
                            14,
                            0.5,
                            14
                        ]
                    },
                    "mm:pressure_plate_pressed": {
                        "on_sound": "click_on.nether_wood_pressure_plate",
                        "off_sound": "click_off.nether_wood_pressure_plate"
                    },
                    "minecraft:tick": {
                        "looping": true,
                        "interval_range": [
                            20,
                            20
                        ]
                    },
                    "minecraft:redstone_producer": {
                        "connected_faces": [
                            "east",
                            "down",
                            "north",
                            "south",
                            "west",
                            "up"
                        ],
                        "power": 15,
                        "strongly_powered_face": "down",
                        "transform_relative": false
                    }
                }
            },
            {
                "condition": "!query.block_state('mm:pressed')",
                "components": {
                    "minecraft:selection_box": {
                        "origin": [
                            -7,
                            0,
                            -7
                        ],
                        "size": [
                            14,
                            1,
                            14
                        ]
                    },
                    "minecraft:tick": {
                        "interval_range": [
                            2,
                            2
                        ],
                        "looping": true
                    },
                    "mm:pressure_plate_unpressed": {
                        "on_sound": "click_on.nether_wood_pressure_plate",
                        "off_sound": "click_off.nether_wood_pressure_plate"
                    },
                    "minecraft:redstone_producer": {
                        "connected_faces": [
                            "east",
                            "down",
                            "north",
                            "south",
                            "west",
                            "up"
                        ],
                        "power": 0,
                        "strongly_powered_face": "down",
                        "transform_relative": true
                    }
                }
            }
        ],
        "components": {
            "minecraft:movable": {
                "movement_type": "popped"
            },
            "minecraft:precipitation_interactions": {
                "precipitation_behavior": "obstruct_rain"
            },
            "minecraft:placement_filter": {
                "conditions": [
                    {
                        "allowed_faces": [
                            "up"
                        ]
                    }
                ]
            },
            "tag:mm:requires_block_below": {},
            "mm:pressure_plate": {
                "on_sound": "click_on.nether_wood_pressure_plate",
                "off_sound": "click_off.nether_wood_pressure_plate"
            },
            "minecraft:light_dampening": 0,
            "minecraft:collision_box": false,
            "minecraft:selection_box": {
                "origin": [
                    -7,
                    0,
                    -7
                ],
                "size": [
                    14,
                    1,
                    14
                ]
            },
            "minecraft:destructible_by_explosion": {
                "explosion_resistance": 0.5
            },
            "minecraft:geometry": {
                "identifier": "geometry.mm_pressure_plate",
                "bone_visibility": {
                    "default": "!query.block_state('mm:pressed')",
                    "pressed": "query.block_state('mm:pressed')"
                }
            },
            "minecraft:material_instances": {
                "*": {
                    "render_method": "alpha_test",
                    "texture": "twisted_planks"
                }
            },
            "minecraft:liquid_detection": {
                "detection_rules": [
                    {
                        "can_contain_liquid": true,
                        "liquid_type": "water"
                    }
                ]
            },
            "minecraft:flammable": true,
            "minecraft:map_color": "#E896F9",
            "minecraft:destructible_by_mining": {
                "seconds_to_destroy": 0.5, //25(Block base speed) * 2/3
                "item_specific_speeds": [
                    {
                        "item": {
                            "tags": "query.any_tag('minecraft:is_axe')"
                        },
                        "destroy_speed": 0.5 //(10/5)*1.5 (blocks hardness)
                    }
                ]
            },
            "tag:axe_mine": {},
            "tag:minecraft:is_axe_item_destructible": {},
            "minecraft:redstone_conductivity": {
                "allows_wire_to_step_down": false,
                "redstone_conductor": true
            }
        }
    }
}