	{
    "format_version": "1.26.40",
    "minecraft:block": {
        "description": {
            "identifier": "mm:twisted_door",
            "menu_category": {
                "category": "construction"
            },
            "states": {
                "mm:open": [
                    false,
                    true
                ],
                "mm:mirror": [
                    false,
                    true
                ]
            },
            "traits": {
                "minecraft:multi_block": {
                    "direction": "up",
                    "parts": 2,
                    "enabled_states": [
                        "minecraft:multi_block_part"
                    ]
                },
                "minecraft:placement_direction": {
                    "enabled_states": [
                        "minecraft:cardinal_direction"
                    ],
                    "y_rotation_offset": 180
                }
            }
        },
        "permutations": [
            {
                //closed
                "condition": "!query.block_state('mm:open')",
                "components": {
                    "minecraft:collision_box": {
                        "origin": [
                            -8,
                            0,
                            -8
                        ],
                        "size": [
                            16,
                            16,
                            3
                        ]
                    },
                    "minecraft:selection_box": {
                        "origin": [
                            -8,
                            0,
                            -8
                        ],
                        "size": [
                            16,
                            16,
                            3
                        ]
                    }
                }
            },
            {
                //open - normal
                "condition": "query.block_state('mm:open') && !q.block_state('mm:mirror')",
                "components": {
                    "minecraft:collision_box": {
                        "origin": [
                            -8,
                            0,
                            -8
                        ],
                        "size": [
                            3,
                            16,
                            16
                        ]
                    },
                    "minecraft:selection_box": {
                        "origin": [
                            -8,
                            0,
                            -8
                        ],
                        "size": [
                            3,
                            16,
                            16
                        ]
                    }
                }
            },
            {
                //open - mirrored
                "condition": "query.block_state('mm:open') && q.block_state('mm:mirror')",
                "components": {
                    "minecraft:collision_box": {
                        "origin": [
                            5,
                            0,
                            -8
                        ],
                        "size": [
                            3,
                            16,
                            16
                        ]
                    },
                    "minecraft:selection_box": {
                        "origin": [
                            5,
                            0,
                            -8
                        ],
                        "size": [
                            3,
                            16,
                            16
                        ]
                    }
                }
            },
            {
                //top
                "condition": "q.block_state('minecraft:multi_block_part') == 1",
                "components": {
                    "minecraft:material_instances": {
                        "*": {
                            "render_method": "alpha_test",
                            "texture": "twisted_door_top"
                        }
                    }
                }
            },
            {
                //bottom
                "condition": "q.block_state('minecraft:multi_block_part') == 0",
                "components": {
                    "minecraft:material_instances": {
                        "*": {
                            "render_method": "alpha_test",
                            "texture": "twisted_door_lower"
                        }
                    }
                }
            },
            {
                "condition": "query.block_state ('minecraft:cardinal_direction') == 'north'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            0,
                            0,
                            0
                        ]
                    }
                }
            },
            {
                "condition": "query.block_state ('minecraft:cardinal_direction') == 'west'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            0,
                            90,
                            0
                        ]
                    }
                }
            },
            {
                "condition": "query.block_state ('minecraft:cardinal_direction') == 'south'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            0,
                            180,
                            0
                        ]
                    }
                }
            },
            {
                "condition": "query.block_state ('minecraft:cardinal_direction') == 'east'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            0,
                            -90,
                            0
                        ]
                    }
                }
            }
        ],
        "components": {
            "minecraft:movable": {
                "movement_type": "popped"
            },
            "minecraft:redstone_consumer": {
                "min_power": 0,
                "propagates_power": true
            },
            "mm:door": {
                "open_sound": "open.nether_wood_door",
                "close_sound": "close.nether_wood_door"
            },
            "minecraft:light_dampening": 0,
            "minecraft:collision_box": {
                "origin": [
                    -8,
                    0,
                    -8
                ],
                "size": [
                    16,
                    3,
                    16
                ]
            },
            "minecraft:selection_box": {
                "origin": [
                    -8,
                    0,
                    -8
                ],
                "size": [
                    16,
                    3,
                    16
                ]
            },
            "minecraft:destructible_by_explosion": {
                "explosion_resistance": 3
            },
            "minecraft:geometry": {
                "identifier": "geometry.mm_door",
                "bone_visibility": {
                    "closed": "!query.block_state('mm:open') && !q.block_state('mm:mirror')",
                    "open": "query.block_state('mm:open') && !q.block_state('mm:mirror')",
                    "closed_m": "!query.block_state('mm:open') && q.block_state('mm:mirror')",
                    "open_m": "query.block_state('mm:open') && q.block_state('mm:mirror')"
                }
            },
            "minecraft:material_instances": {
                "*": {
                    "render_method": "alpha_test",
                    "texture": "twisted_door_lower"
                }
            },
            "minecraft:liquid_detection": {
                "detection_rules": [
                    {
                        "can_contain_liquid": true,
                        "liquid_type": "water"
                    }
                ]
            },
            "minecraft:placement_filter": {
                "conditions": [
                    {
                        "allowed_faces": [
                            "up"
                        ]
                    }
                ]
            },
            "minecraft:precipitation_interactions": {
                "precipitation_behavior": "obstruct_rain"
            },
            "minecraft:flammable": true,
            "minecraft:map_color": "#E896F9",
            "minecraft:destructible_by_mining": {
                "seconds_to_destroy": 2, //25(Block base speed) * 2/3
                "item_specific_speeds": [
                    {
                        "item": {
                            "tags": "query.any_tag('minecraft:is_axe')"
                        },
                        "destroy_speed": 2 //(10/5)*1.5 (blocks hardness)
                    }
                ]
            },
            "minecraft:tags": ["axe_mine", "minecraft:is_axe_item_destructible", "mm:requires_block_below"],
            "minecraft:redstone_conductivity": {
                "allows_wire_to_step_down": false,
                "redstone_conductor": true
            }
        }
    }
}