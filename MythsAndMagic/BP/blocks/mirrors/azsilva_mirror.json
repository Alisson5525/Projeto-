{
    "format_version": "1.26.0",
    "minecraft:block": {
        "description": {
            "identifier": "mm:azsilva_mirror",
            "menu_category": {
                "category": "items"
            },
            "states": {
                "mm:locked": [
                    false,
                    true
                ],
                "mm:prevent_player_interaction": [
                    false,
                    true
                ]
            },
            "traits": {
                "minecraft:placement_direction": {
                    "enabled_states": [
                        "minecraft:cardinal_direction"
                    ]
                }
            }
        },
        "components": {
            "minecraft:redstone_consumer": {
                "min_power": 0,
                "propogates_power": true
            },
            "mm:azsilva_mirror": {},
            "minecraft:collision_box": {
                "origin": [
                    -8,
                    0,
                    -8
                ],
                "size": [
                    16,
                    24,
                    16
                ]
            },
            "minecraft:selection_box": {
                "origin": [
                    -8,
                    0,
                    -8
                ],
                "size": [
                    16,
                    8,
                    16
                ]
            },
            "minecraft:destructible_by_explosion": {
                "explosion_resistance": 3
            },
            "minecraft:destructible_by_mining": {
                "seconds_to_destroy": 16.667, //25(Block base speed) * 2/3
                "item_specific_speeds": [
                    {
                        "item": {
                            "tags": "query.any_tag('minecraft:is_pickaxe')"
                        },
                        "destroy_speed": 5 //(10/5)*1.5 (blocks hardness)
                    }
                ]
            },
            "tag:pickaxe_mine": {},
            "tag:minecraft:is_pickaxe_item_destructible": {},
            "minecraft:liquid_detection": {
                "detection_rules": [
                    {
                        "can_contain_liquid": true
                    }
                ]
            },
            "minecraft:destruction_particles": {
                "texture": "stone"
            },
            "minecraft:geometry": {
                "identifier": "geometry.mirror_panel"
            },
            "minecraft:material_instances": {
                "*": {
                    "texture": "azsilva_mirror",
                    "render_method": "alpha_test"
                }
            }
        },
        "permutations": [
            {
                "condition": "query.block_state('mm:locked') == true",
                "components": {
                    "minecraft:material_instances": {
                        "*": {
                            "texture": "azsilva_mirror_locked",
                            "render_method": "alpha_test"
                        }
                    }
                }
            },
            {
                "condition": "query.block_state('minecraft:cardinal_direction') == 'north'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            0,
                            180,
                            0
                        ]
                    }
                }
            },
            {
                "condition": "query.block_state('minecraft:cardinal_direction') == 'south'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            0,
                            0,
                            0
                        ]
                    }
                }
            },
            {
                "condition": "query.block_state('minecraft:cardinal_direction') == 'east'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            0,
                            90,
                            0
                        ]
                    }
                }
            },
            {
                "condition": "query.block_state('minecraft:cardinal_direction') == 'west'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            0,
                            -90,
                            0
                        ]
                    }
                }
            }
        ]
    }
}