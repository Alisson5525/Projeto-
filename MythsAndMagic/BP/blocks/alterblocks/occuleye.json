{
    "format_version": "1.21.130",
    "minecraft:block": {
        "description": {
            "identifier": "mm:occuleye",
            "traits": {
                "minecraft:placement_position": {
                    "enabled_states": [
                        "minecraft:block_face"
                    ]
                }
            }
        },
        "permutations": [
            {
                "condition": "query.block_state('minecraft:block_face') == 'up'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            0,
                            0,
                            0
                        ]
                    }
                }
            },
            {
                "condition": "query.block_state('minecraft:block_face') == 'north'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            -90,
                            0,
                            0
                        ]
                    }
                }
            },
            {
                "condition": "query.block_state('minecraft:block_face') == 'south'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            90,
                            0,
                            0
                        ]
                    }
                }
            },
            {
                "condition": "query.block_state('minecraft:block_face') == 'east'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            0,
                            90,
                            -90
                        ]
                    }
                }
            },
            {
                "condition": "query.block_state('minecraft:block_face') == 'west'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            0,
                            -90,
                            90
                        ]
                    }
                }
            },
            {
                "condition": "query.block_state('minecraft:block_face') == 'down'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            -180,
                            0,
                            0
                        ]
                    }
                }
            }
        ],
        "components": {
            "minecraft:liquid_detection": {
                "detection_rules": [
                    {
                        "can_contain_liquid": true,
                        "liquid_type": "water"
                    }
                ]
            },
            "minecraft:material_instances": {
                "*": {
                    "texture": "occuleye",
                    "render_method": "alpha_test"
                }
            },
            "minecraft:selection_box": {
                "origin": [
                    -4,
                    0,
                    -4
                ],
                "size": [
                    8,
                    6,
                    8
                ]
            },
            "minecraft:collision_box": {
                "origin": [
                    -4,
                    0,
                    -4
                ],
                "size": [
                    8,
                    6,
                    8
                ]
            },
            "minecraft:destructible_by_explosion": {
                "explosion_resistance": 0.1
            },
            "minecraft:destructible_by_mining": {
                "seconds_to_destroy": 0.1, //25(Block base speed) * 2/3
                "item_specific_speeds": [
                    {
                        "item": {
                            "tags": "query.any_tag('minecraft:is_hoe')"
                        },
                        "destroy_speed": 0.1 //(10/5)*1.5 (blocks hardness)
                    }
                ]
            },
            "tag:hoe_mine": {},
            "tag:minecraft:is_hoe_item_destructible": {},
            "minecraft:geometry": {
                "identifier": "geometry.occuleye"
            }
        }
    }
}