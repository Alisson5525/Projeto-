{
    "format_version": "1.21.130",
    "minecraft:block": {
        "description": {
            "identifier": "mm:meteor_lantern",
            "traits": {
                "minecraft:placement_position": {
                    "enabled_states": [
                        "minecraft:block_face"
                    ]
                }
            }
        },
        "permutations": [
            {
                "condition": "query.block_state('minecraft:block_face') == 'up'",
                "components": {
                    "minecraft:selection_box": {
                        "origin": [
                            -3,
                            0,
                            -3
                        ],
                        "size": [
                            6,
                            8,
                            6
                        ]
                    },
                    "minecraft:collision_box": {
                        "origin": [
                            -3,
                            0,
                            -3
                        ],
                        "size": [
                            6,
                            8,
                            6
                        ]
                    }
                }
            },
            {
                "condition": "query.block_state('minecraft:block_face') == 'down'",
                "components": {
                    "minecraft:selection_box": {
                        "origin": [
                            -3,
                            1,
                            -3
                        ],
                        "size": [
                            6,
                            8,
                            6
                        ]
                    },
                    "minecraft:collision_box": {
                        "origin": [
                            -3,
                            1,
                            -3
                        ],
                        "size": [
                            6,
                            8,
                            6
                        ]
                    }
                }
            }
        ],
        "components": {
            "tag:pickaxe_mine": {},
            "tag:minecraft:is_pickaxe_item_destructible": {},
            "minecraft:destructible_by_mining": {
                "seconds_to_destroy": 5, //3.5
                "item_specific_speeds": [
                    {
                        "item": {
                            "tags": "query.any_tag('minecraft:is_pickaxe')"
                        },
                        "destroy_speed": 3.5 //(10/5)*1.5 (blocks hardness)
                    }
                ]
            },
            "minecraft:liquid_detection": {
                "detection_rules": [
                    {
                        "can_contain_liquid": true,
                        "liquid_type": "water"
                    }
                ]
            },
            "minecraft:geometry": {
                "identifier": "geometry.sparkling_lantern",
                "bone_visibility": {
                    "lantern_floor": "query.block_state('minecraft:block_face') == 'up'",
                    "lantern_hanging": "query.block_state('minecraft:block_face') == 'down'"
                }
            },
            "minecraft:light_emission": 15,
            "minecraft:light_dampening": 0,
            "minecraft:placement_filter": {
                "conditions": [
                    {
                        "allowed_faces": [ // Decides in which faces the torch can be placed
                            "up",
                            "down"
                        ]
                    }
                ]
            },
            "minecraft:material_instances": {
                "*": {
                    "texture": "meteor_lantern",
                    "render_method": "alpha_test",
                    "ambient_occlusion": false,
                    "face_dimming": false
                }
            },
            "minecraft:transformation": {
                "rotation": [
                    0,
                    90,
                    0
                ]
            },
            "minecraft:collision_box": {
                "origin": [
                    -8,
                    0,
                    -8
                ],
                "size": [
                    16,
                    15,
                    16
                ]
            },
            "minecraft:selection_box": {
                "origin": [
                    -8,
                    0,
                    -8
                ],
                "size": [
                    16,
                    15,
                    16
                ]
            },
            "minecraft:destructible_by_explosion": {
                "explosion_resistance": 3.5
            }
        }
    }
}