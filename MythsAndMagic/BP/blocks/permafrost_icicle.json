{
    "format_version": "1.21.130",
    "minecraft:block": {
        "description": {
            "identifier": "mm:permafrost_icicle",
            "traits": {
                "minecraft:placement_position": {
                    "enabled_states": [
                        "minecraft:block_face"
                    ]
                }
            },
            "states": {
                "mm:tip": [
                    true,
                    false
                ],
                "mm:from_slushbuckler": [
                    false,
                    true
                ]
            }
        },
        "permutations": [
            {
                "condition": "query.block_state('mm:from_slushbuckler') == false",
                "components": {
                    "minecraft:loot": "loot_tables/blocks/permafrost_icicle_rare.json"
                }
            },
            {
                "condition": "query.block_state('mm:from_slushbuckler') == true",
                "components": {
                    "minecraft:loot": "loot_tables/blocks/permafrost_icicle.json"
                }
            },
            {
                "condition": "query.block_state('minecraft:block_face') == 'up' && query.block_state('mm:tip') == false",
                "components": {
                    "minecraft:material_instances": {
                        "*": {
                            "texture": "permafrost_crystal_up_mid",
                            "render_method": "alpha_test"
                        }
                    },
                    "minecraft:selection_box": {
                        "origin": [
                            -6,
                            0,
                            -6
                        ],
                        "size": [
                            12,
                            16,
                            12
                        ]
                    },
                    "minecraft:collision_box": {
                        "origin": [
                            -6,
                            0,
                            -6
                        ],
                        "size": [
                            12,
                            16,
                            12
                        ]
                    }
                }
            },
            {
                "condition": "query.block_state('minecraft:block_face') == 'down' && query.block_state('mm:tip') == false",
                "components": {
                    "minecraft:material_instances": {
                        "*": {
                            "texture": "permafrost_crystal_down_mid",
                            "render_method": "alpha_test"
                        }
                    },
                    "minecraft:selection_box": {
                        "origin": [
                            -6,
                            0,
                            -6
                        ],
                        "size": [
                            12,
                            16,
                            12
                        ]
                    },
                    "minecraft:collision_box": {
                        "origin": [
                            -6,
                            0,
                            -6
                        ],
                        "size": [
                            12,
                            16,
                            12
                        ]
                    }
                }
            },
            {
                "condition": "query.block_state('minecraft:block_face') == 'up' && query.block_state('mm:tip') == true",
                "components": {
                    "minecraft:material_instances": {
                        "*": {
                            "texture": "permafrost_crystal_up",
                            "render_method": "alpha_test"
                        }
                    },
                    "minecraft:selection_box": {
                        "origin": [
                            -6,
                            0,
                            -6
                        ],
                        "size": [
                            12,
                            12,
                            12
                        ]
                    },
                    "minecraft:collision_box": {
                        "origin": [
                            -6,
                            0,
                            -6
                        ],
                        "size": [
                            12,
                            12,
                            12
                        ]
                    }
                }
            },
            {
                "condition": "query.block_state('minecraft:block_face') == 'down' && query.block_state('mm:tip') == true",
                "components": {
                    "minecraft:material_instances": {
                        "*": {
                            "texture": "permafrost_crystal_down",
                            "render_method": "alpha_test"
                        }
                    },
                    "minecraft:selection_box": {
                        "origin": [
                            -6,
                            4,
                            -6
                        ],
                        "size": [
                            12,
                            12,
                            12
                        ]
                    },
                    "minecraft:collision_box": {
                        "origin": [
                            -6,
                            4,
                            -6
                        ],
                        "size": [
                            12,
                            12,
                            12
                        ]
                    }
                }
            }
        ],
        "components": {
            "mm:permafrost_icicle": {},
            "minecraft:tick": {
                "interval_range": [
                    1,
                    1
                ],
                "looping": true
            },
            "minecraft:selection_box": false,
            "minecraft:collision_box": false,
            "minecraft:precipitation_interactions": {
                "precipitation_behavior": "none"
            },
            "minecraft:destructible_by_explosion": {
                "explosion_resistance": 3
            },
            "minecraft:destructible_by_mining": {
                "seconds_to_destroy": 2
            },
            "minecraft:geometry": {
                "identifier": "geometry.permafrost_crystal"
            },
            "minecraft:movable": {
                "movement_type": "popped"
            },
            "minecraft:liquid_detection": {
                "detection_rules": [
                    {
                        "can_contain_liquid": true,
                        "liquid_type": "water"
                    }
                ]
            },
            "minecraft:material_instances": {
                "*": {
                    "texture": "permafrost_crystal_up",
                    "render_method": "alpha_test"
                }
            },
            "minecraft:loot": "loot_tables/blocks/permafrost_icicle_rare.json",
            "tag:pickaxe_mine": {},
            "tag:minecraft:is_pickaxe_item_destructible": {}
        }
    }
}