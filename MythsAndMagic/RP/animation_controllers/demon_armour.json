{
	"format_version": "1.19.0",
	"animation_controllers": {
		"controller.animation.demon_armour.walk": {
			"initial_state": "idle",
			"states": {
				"idle": {
					"transitions": [
						{
							"walking": "query.is_moving"
						}
					],
					"blend_transition": 0.6
				},
				"walking": {
					"animations": [
						"walk"
					],
					"transitions": [
						{
							"idle": "!query.is_moving"
						}
					],
					"blend_transition": 0.6
				}
			}
		}
	}
}