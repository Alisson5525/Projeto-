{
	"format_version": "1.19.0",
	"animation_controllers": {
		"controller.animation.guardian_myth.attack": {
			"initial_state": "idle",
			"states": {
				"idle": {
					"transitions": [
						{
							"attacking": "query.is_delayed_attacking"
						},
						{
							"casting": "query.property('mm:is_casting_hellfire')"
						}
					],
					"blend_transition": 0.0
				},
				"attacking": {
					"animations": [
						{
							"attack_full": "q.property('mm:hands_active') >= 2"
						},
						{
							"attack_half": "q.property('mm:hands_active') < 2"
						},
						{
							"attack": "q.property('mm:hands_active') >= 0"
						}
					],
					"transitions": [
						{
							"idle": "query.all_animations_finished"
						},
						{
							"casting": "query.property('mm:is_casting_hellfire')"
						}
					],
					"blend_transition": 0.3
				},
				"casting": {
					"animations": [
						"casting"
					],
					"transitions": [
						{
							"idle": "!query.property('mm:is_casting_hellfire')"
						}
					],
					"blend_transition": 0.0
				}
			}
		}
	}
}