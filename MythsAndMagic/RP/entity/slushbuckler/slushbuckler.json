{
    "format_version": "1.10.0",
    "minecraft:client_entity": {
        "description": {
            "identifier": "mm:slushbuckler",
            "min_engine_version": "1.10.0",
            "materials": {
                "default": "entity_alphatest"
            },
            "textures": {
                "default": "textures/entity/slushbuckler/slushbuckler"
            },
            "geometry": {
                "default": "geometry.slushbuckler"
            },
            "scripts": {
                "pre_animation": [
                    "variable.tcos0 = (Math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed / variable.gliding_speed_value) * 57.3;"
                ],
                "animate": [
                    "popsicle_controller",
                    "walk_controller",
                    "sit_controller"
                ]
            },
            "animations": {
                "popsicle_controller": "controller.animation.slushbuckler.popsicle",
                "walk_controller": "controller.animation.slushbuckler.walk",
                "sit_controller": "controller.animation.slushbuckler.sit",
                "popsicle_hidden": "animation.slushbuckler.popsicle_hidden",
                "eat_popsicle": "animation.slushbuckler.eat_popsicle",
                "idle": "animation.slushbuckler.idle",
                "walk": "animation.slushbuckler.walk",
                "look_at_target": "animation.common.look_at_target",
                "stand": "animation.slushbuckler.stand",
                "sit": "animation.slushbuckler.sit",
                "snowstorm": "animation.slushbuckler.snowstorm"
            },
            "sound_effects": {
                "popsicle": "mob.slushbuckler.popsicle",
                "sit": "mob.slushbuckler.sit",
                "stand": "mob.slushbuckler.stand",
                "snowstorm": "mob.slushbuckler.snowstorm"
            },
            "render_controllers": [
                "controller.render.default"
            ],
            "spawn_egg": {
                "texture": "egg_slushbuckler"
            }
        }
    }
}