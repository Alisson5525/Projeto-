                "hide_controller": "controller.animation.mage.hide",
                "idle": "animation.mage.idle",
                "walk": "animation.mage.walk",
                "hat_jump": "animation.mage.hat_jump",
                "walk_controller": "controller.animation.mage.walk",
                "hat_jump_controller": "controller.animation.mage.hat_jump",
                "hide": "animation.mage.hide",
                "unhide": "animation.mage.unhide",
                "use_crystal": "animation.mage.use_crystal"
            },
            "render_controllers": [
                "controller.render.default"
            ],
            "spawn_egg": {
                "texture": "egg_mage"
            }
