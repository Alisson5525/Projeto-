{
    "format_version": "1.10.0",
    "minecraft:client_entity": {
        "description": {
            "identifier": "mm:mage",
            "min_engine_version": "1.10.0",
            "materials": {
                "default": "entity_emissive_alpha"
            },
            "textures": {
                "default": "textures/entity/mage/mage"
            },
            "geometry": {
                "default": "geometry.mage"
            },
            "scripts": {
                "animate": [
                    "hide_controller",
                    "crystal_controller",
                    "walk_controller",
                    "hat_jump_controller"
                ]
            },
            "sound_effects": {
                "use_crystal": "mob.mage.use_crystal",
                "refuse_crystal": "mob.mage.refuse_crystal"
            },
            "animations": {
