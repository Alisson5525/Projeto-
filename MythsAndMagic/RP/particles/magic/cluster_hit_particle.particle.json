{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "mm:cluster_hit_particle",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particles/burst_aura"
			}
		},
		"curves": {
			"variable.shrink": {
				"type": "linear",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [1, 0]
			},
			"variable.speed": {
				"type": "bezier",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [1, 2, 2, 2]
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 10
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": "1/5"
			},
			"minecraft:emitter_shape_point": {
				"direction": ["v.particle_random_1*2-1", 1, "v.particle_random_2*2-1"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "2 - v.particle_random_3/2"
			},
			"minecraft:particle_initial_speed": "8 - v.particle_random_4*3",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, -9, 0],
				"linear_drag_coefficient": 0.2
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["0.5 * variable.shrink", "0.05 * variable.shrink"],
				"facing_camera_mode": "lookat_direction"
			},
			"minecraft:particle_motion_collision": {
				"collision_radius": 0.1,
				"expire_on_contact": true
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFFF0000",
						"0.5": "#FFffda0b",
						"1.0": "#FFeff0dd"
					}
				}
			}
		}
	}
}