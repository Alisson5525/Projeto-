{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "mm:snowball_swirls",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particles/chilling_swirls"
			}
		},
		"curves": {
			"variable.size": {
				"type": "linear",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [0, 1, 0]
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 4,
				"max_particles": 100
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_sphere": {
				"radius": 0.2,
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "1 + v.particle_random_1"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(0,369)"
			},
			"minecraft:particle_initial_speed": 2,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, "1 - (v.particle_lifetime*1)", 0],
				"linear_drag_coefficient": 1
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["0.1*variable.size", "0.1*variable.size"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 8,
					"texture_height": 1,
					"flipbook": {
						"base_UV": [0, 0],
						"size_UV": [1, 1],
						"step_UV": [1, 0],
						"frames_per_second": 33,
						"max_frame": 8,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFCEF5FF",
						"1.0": "#FFFFFFFF"
					}
				}
			}
		}
	}
}