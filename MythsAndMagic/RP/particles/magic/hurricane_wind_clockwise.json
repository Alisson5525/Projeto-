{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "mm:hurricane_wind_clockwise",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particles/hurricane_sparks"
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "variable.size = 0.02;variable.radius = 3.5;"
			},
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": true
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 333,
				"max_particles": 1111
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 5
			},
			"minecraft:emitter_shape_point": {
				"offset": [
					"variable.radius*-math.sin(variable.emitter_age*-180)",
					0,
					"variable.radius*math.cos(variable.emitter_age*180)"
				]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.3,6)"
			},
			"minecraft:particle_initial_speed": 2,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [
					0,
					1,
					0
				],
				"linear_drag_coefficient": 1
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"variable.size*(1-variable.particle_age)",
					"variable.size*(1-variable.particle_age)"
				],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"uv": [
						32,
						88
					],
					"uv_size": [
						8,
						8
					]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFC0B2C2",
						"0.5": "#ffffffff"
					}
				}
			}
		}
	}
}