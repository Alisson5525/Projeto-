{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "mm:purify_ring",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particles/particles_glow"
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "variable.size = 0.08;variable.radius = 2;"
			},
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": true
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 99,
				"max_particles": 121
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 2
			},
			"minecraft:emitter_shape_point": {
				"offset": [
					"variable.radius*-math.sin(variable.emitter_age*360)",
					0,
					"variable.radius*math.cos(variable.emitter_age*360)"
				],
				"direction": [
					0,
					1,
					0
				]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "v.particle_random_1+1"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(0,359)"
			},
			"minecraft:particle_initial_speed": 1,
			"minecraft:particle_motion_dynamic": {},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"(variable.size*(v.particle_lifetime-variable.particle_age)) + v.particle_random_4/80",
					"(variable.size*(v.particle_lifetime-variable.particle_age)) + v.particle_random_4/80"
				],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"flipbook": {
						"base_UV": [
							0,
							88
						],
						"size_UV": [
							8,
							8
						],
						"step_UV": [
							8,
							0
						],
						"max_frame": 8,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFDE75FF",
						"1.0": "#FFFFDCE9"
					}
				}
			}
