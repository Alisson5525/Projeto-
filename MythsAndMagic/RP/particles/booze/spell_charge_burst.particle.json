{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "mm:spell_charge_burst",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particles/particles_glow"
			}
		},
		"curves": {
			"variable.size": {
				"type": "linear",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [
					0,
					1,
					0.3
				]
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 50
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_sphere": {
				"radius": 0.1,
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "v.particle_random_1/1.5+ 0.5"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(0,359)",
				"rotation_rate": "v.particle_lifetime*360"
			},
			"minecraft:particle_initial_speed": "2 + v.particle_random_2*3",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [
					0,
					3,
					0
				],
				"rotation_acceleration": 12
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"(0.15 + v.particle_random_3/10)*v.size",
					"(0.15 + v.particle_random_3/10)*v.size"
				],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"flipbook": {
						"base_UV": [
							0,
							8
						],
						"size_UV": [
							1,
							1
						],
						"step_UV": [
							1,
							0
						],
						"max_frame": 8,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFFF60C8",
						"1.0": "#FFA900FF"
					}
				}
			}
		}
	}
}