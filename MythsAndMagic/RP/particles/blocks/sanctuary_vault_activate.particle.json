{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "mm:sanctuary_vault_activate",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particles/burst_aura"
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "variable.size = 0.05;variable.radius = 0.75;"
			},
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": true
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 31,
				"max_particles": 60
			},
			"minecraft:emitter_lifetime_looping": {
				"active_time": 2.5
			},
			"minecraft:emitter_shape_point": {
				"offset": [
					"variable.radius*-math.sin(variable.emitter_age*360+(v.emitter_age*128))",
					"0.5+variable.emitter_age*1.5",
					"variable.radius*math.cos(variable.emitter_age*360+(v.emitter_age*128))"
				]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 1
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(0,359)"
			},
			"minecraft:particle_initial_speed": "(v.particle_random_1 + v.emitter_age)/10",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [
					0,
					"v.emitter_age-1",
					0
				]
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"(variable.size*(1-variable.particle_age))",
					"(variable.size*(1-variable.particle_age))"
				],
				"facing_camera_mode": "rotate_xyz"
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFFF004D",
						"1.0": "#00680000"
					}
				}
			}
		}
	}
}