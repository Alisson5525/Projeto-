{
  "namespace": "hud",
  "hud_actionbar_text": {
    "type": "image",
    "size": [
      "100%c + 12px",
      "100%c + 5px"
    ],
    "$atext": "$actionbar_text",
    "offset": "$offset",
    "texture": "$texture",
    "alpha": "$alpha",
    "visible": "$visible",
    "$font_scale|default": 1,
    "$offset|default": [
      0,
      "50%-68px"
    ],
    "$texture|default": "textures/ui/hud_tip_text_background",
    "$alpha|default": "@hud.anim_actionbar_text_background_alpha_out",
    "$visible|default": true,
    "variables": [
      {
        "requires": "($atext = ' ')",
        "$visible": false
      },
      {
        "requires": "((not($atext - '§m§n§a§l' = $atext)) and ($atext - '§s§o§u§l§r' = $atext) and ($atext - '§q§u§i§v§r' = $atext) and ($atext - '§c§o§o§l§r' = $atext) and ($atext - '§c§l§o§c§r' = $atext) and ($atext - '§s§d§i§a§m' = $atext))",
        "$offset": [
          150,
          "50%-15px"
        ],
        "$texture": "textures/ui/mana_bar_bg_locked",
        "$alpha": 1
      },
      {
        "requires": "((not($atext - '§m§n§a' = $atext)) and ($atext - '§m§n§a§l' = $atext) and ($atext - '§s§o§u§l§r' = $atext) and ($atext - '§q§u§i§v§r' = $atext) and ($atext - '§c§o§o§l§r' = $atext) and ($atext - '§c§l§o§c§r' = $atext) and ($atext - '§s§d§i§a§m' = $atext))",
        "$offset": [
          150,
          "50%-15px"
        ],
        "$texture": "textures/ui/mana_bar_bg",
        "$alpha": 1
      },
      {
        "requires": "((not($atext - '§s§o§u§l§r' = $atext)) and ($atext - '§m§n§a' = $atext) and ($atext - '§m§n§a§l' = $atext) and ($atext - '§q§u§i§v§r' = $atext) and ($atext - '§c§o§o§l§r' = $atext) and ($atext - '§c§l§o§c§r' = $atext) and ($atext - '§s§d§i§a§m' = $atext))",
        "$offset": [
          150,
          "50%-15px"
        ],
        "$font_scale": 1,
        "$texture": "textures/ui/soul_bar_bg",
        "$alpha": 1
      },
      {
        "requires": "((not($atext - '§q§u§i§v§r' = $atext)) and ($atext - '§m§n§a' = $atext) and ($atext - '§m§n§a§l' = $atext) and ($atext - '§s§o§u§l§r' = $atext) and ($atext - '§c§o§o§l§r' = $atext) and ($atext - '§c§l§o§c§r' = $atext) and ($atext - '§s§d§i§a§m' = $atext))",
        "$offset": [
          150,
          "50%-15px"
        ],
        "$texture": "textures/ui/quiver_bg",
        "$alpha": 1
      },
      {
        "requires": "((not($atext - '§c§o§o§l§r' = $atext)) and ($atext - '§m§n§a' = $atext) and ($atext - '§m§n§a§l' = $atext) and ($atext - '§s§o§u§l§r' = $atext) and ($atext - '§q§u§i§v§r' = $atext) and ($atext - '§c§l§o§c§r' = $atext) and ($atext - '§s§d§i§a§m' = $atext))",
        "$offset": [
          150,
          "50%-15px"
        ],
        "$texture": "textures/ui/cooldown_timer_bg",
        "$alpha": 1
      },
      {
        "requires": "((not($atext - '§c§l§o§c§r' = $atext)) and ($atext - '§m§n§a§l' = $atext) and ($atext - '§m§n§a' = $atext) and ($atext - '§s§o§u§l§r' = $atext) and ($atext - '§q§u§i§v§r' = $atext) and ($atext - '§c§o§o§l§r' = $atext) and ($atext - '§s§d§i§a§m' = $atext))",
        "$offset": [
          150,
          "50%-15px"
        ],
        "$texture": "textures/ui/mana_bar_clock",
        "$alpha": 1
      },
      {
        "requires": "((not($atext - '§s§d§i§a§m' = $atext)) and ($atext - '§m§n§a§l' = $atext) and ($atext - '§m§n§a' = $atext) and ($atext - '§s§o§u§l§r' = $atext) and ($atext - '§q§u§i§v§r' = $atext) and ($atext - '§c§o§o§l§r' = $atext) and ($atext - '§c§l§o§c§r' = $atext))",
        "$offset": [
          170,
          "50%-24px"
        ],
        "$font_scale": 1.5,
        "$alpha": 0
      }
    ],
    "controls": [
      {
        "actionbar_message": {
          "type": "label",
          "font_scale_factor": "$font_scale",
          "anchor_from": "center",
          "anchor_to": "center",
          "color": "$tool_tip_text",
          "enable_profanity_filter": true,
          "layer": 31,
          "text": "$actionbar_text",
          "localize": false,
          "alpha": "@hud.anim_actionbar_text_alpha_out"
        }
      }
    ]
  },
  "test_panel": {
    "type": "panel",
    "anchor_from": "top_right",
    "anchor_to": "top_right",
    "size": [
      "100%",
      "100%cm + 0.5px"
    ],
    "controls": [
      {
        "test@hud.test": {}
      }
    ]
  },
  "test": {
    "type": "image",
    "anchor_to": "top_right",
    "anchor_from": "top_right",
    "texture": "#texture",
    "size": [
      "100%c + 30px",
      "95%c - 10px"
    ],
    "offset": "@hud.test_anim",
    "layer": 998,
    "bindings": [
      {
        "binding_name": "#text"
      },
      {
        "binding_type": "view",
        "source_property_name": "(('%.6s' * #text) = 'toast.')",
        "target_property_name": "#visible"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#text - 'toast.')",
        "target_property_name": "#text_remainder"
      },
      {
        "binding_type": "view",
        "source_property_name": "('%.150s' * #text_remainder)",
        "target_property_name": "#adv_icon_field"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#adv_icon_field - '$')",
        "target_property_name": "#adv_icon"
      },
      {
        "binding_type": "view",
        "source_property_name": "(('%.200s' * #text_remainder) - #adv_icon_field)",
        "target_property_name": "#adv_bg_field"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#adv_bg_field - '$')",
        "target_property_name": "#texture"
      },
      {
        "binding_type": "view",
        "source_property_name": "(((#text_remainder - '$') - #adv_icon) - (#adv_bg_field - '$'))",
        "target_property_name": "#adv_text"
      }
    ],
    "controls": [
      {
        "text": {
          "type": "label",
          "layer": 999,
          "text": "#text",
          "anchor_to": "left_middle",
          "anchor_from": "left_middle",
          "offset": [
            "32px",
            "-1%"
          ],
          "localize": true,
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "test",
              "source_property_name": "#adv_text",
              "target_property_name": "#text",
              "resolve_sibling_scope": true
            },
            {
              "binding_type": "view",
              "source_property_name": "(not (#text = ''))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "icon": {
          "type": "image",
          "layer": 1000,
          "size": [
            "20px",
            "20px"
          ],
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "offset": [
            "4px",
            "0%"
          ],
          "keep_ratio": true,
          "texture": "#texture",
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "test",
              "source_property_name": "#adv_icon",
              "target_property_name": "#texture",
              "resolve_sibling_scope": true
            },
            {
              "binding_type": "view",
              "binding_condition": "once",
              "source_property_name": "(not (#texture = ''))",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },
  "test_anim": {
    "anim_type": "offset",
    "easing": "out_sine",
    "next": "@hud.test_anim2",
    "from": [
      "100%c + 40px",
      "20px"
    ],
    "to": [
      "0%",
      "20px"
    ],
    "duration": 1
  },
  "test_anim2": {
    "anim_type": "wait",
    "next": "@hud.test_anim3",
    "duration": 4
  },
  "test_anim3": {
    "anim_type": "offset",
    "easing": "in_sine",
    "from": [
      "0%",
      "20px"
    ],
    "to": [
      "100%c + 40px",
      "20px"
    ],
    "duration": 1,
    "destroy_at_end": "chat_grid_item"
  },
  "test_factory": {
    "type": "stack_panel",
    "size": [
      "100%",
      "100%"
    ],
    "factory": {
      "name": "chat_item_factory",
      "control_ids": {
        "chat_item": "test_panel@hud.test_panel"
      }
    }
  },
  "root_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": [
          {
            "test_factory@hud.test_factory": {}
          }
        ]
      }
    ]
  },
  "chat_grid_item/chat_background": {
    "bindings": [
      {
        "binding_type": "view",
        "source_property_name": "(('§␛' + #text + '§r') - ('§␛' + 'toast.') = ('§␛' + #text + '§r'))",
        "target_property_name": "#visible"
      }
    ]
  }
}
