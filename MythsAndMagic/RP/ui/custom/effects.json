{
  "namespace": "mm_effects",
  // METALLURGY
  "metallurgy_effect_wrapper": {
    "type": "panel",
    "anchor_from": "top_right",
    "anchor_to": "top_right",
    "size": [
      0,
      0
    ],
    "offset": [
      -10,
      5
    ],
    "controls": [
      {
        "metallurgy_effect1@metallurgy_effect": {
          "offset": [
            -36,
            62
          ],
          "$update_string": "§mm:metallurgy:",
          "$controls": [
            {
              "metallurgy@custom_actual_effect": {
                "$bindings": [
                  {
                    "binding_type": "view",
                    "source_control_name": "data_control_metallurgy1",
                    "source_property_name": "(not (#preserved_text = $update_string) and not (#preserved_text = ''))",
                    "target_property_name": "#visible"
                  }
                ],
                "$controls": [
                  {
                    "metallurgy_img@mm_effects.metallurgy_img": {
                      "$bindings": [
                        {
                          "binding_type": "view",
                          "source_control_name": "data_control_metallurgy1",
                          "source_property_name": "((#preserved_text - $update_string) * 1.0)",
                          "target_property_name": "#health"
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "data_control_metallurgy1@data_control_METALLURGY_EFFECT": {}
            }
          ],
          "$bindings": [
            {
              "binding_type": "view",
              "source_control_name": "data_control_metallurgy1",
              "source_property_name": "(#preserved_text - $update_string)",
              "target_property_name": "#text"
            }
          ]
        }
      }
    ]
  },
  "data_control_METALLURGY_EFFECT": {
    "type": "panel",
    "size": [
      0,
      0
    ],
    "bindings": [
      {
        "binding_name": "#hud_title_text_string"
      },
      {
        "binding_name": "#hud_title_text_string",
        "binding_name_override": "#preserved_text",
        "binding_condition": "visibility_changed"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not (#hud_title_text_string = #preserved_text) and not ((#hud_title_text_string - $update_string) = #hud_title_text_string))",
        "target_property_name": "#visible"
      }
    ]
  },
  "metallurgy_img": {
    "type": "image",
    "size": [
      "100% -8px",
      "100% -8px"
    ],
    "texture": "textures/ui/effects/metallurgy",
    "layer": 1,
    "bindings": "$bindings"
  },
  "metallurgy_effect": {
    "type": "label",
    "text": "#text",
    "text_alignment": "right",
    "$max_health": 1.0,
    "controls": "$controls",
    "bindings": "$bindings"
  },
