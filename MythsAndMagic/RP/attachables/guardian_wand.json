{
	"format_version": "1.10.0",
	"minecraft:attachable": {
		"description": {
			"identifier": "mm:guardian_wand",
			"render_controllers": [
				"controller.render.item_default"
			],
			"materials": {
				"default": "entity_alphatest",
				"enchanted": "entity_alphatest_glint"
			},
			"textures": {
				"default": "textures/items/guardian_wand_held",
				"enchanted": "textures/misc/enchanted_item_glint"
			},
			"geometry": {
				"default": "geometry.guardian_wand"
			},
			"animations": {
				"first_person_hold": "animation.guardian_wand.first_person_hold",
				"first_person_hold_offhand": "animation.guardian_wand.first_person_hold_offhand",
				"third_person_hold": "animation.guardian_wand.third_person_hold"
			},
			"scripts": {
				"initialize": [
					"v.offhand = 0;"
				],
				"pre_animation": [
					"v.offhand = q.item_slot_to_bone_name(c.item_slot) == 'rightitem' ? 0 : 1;"
				],
				"animate": [
					{
						"first_person_hold": "c.is_first_person && !v.offhand"
					},
					{
						"first_person_hold_offhand": "c.is_first_person && v.offhand"
					},
					{
						"third_person_hold": "!c.is_first_person"
					}
				]
			}
		}
	}
}