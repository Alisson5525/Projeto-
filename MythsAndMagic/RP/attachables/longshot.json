{
	"format_version": "1.10.0",
	"minecraft:attachable": {
		"description": {
			"identifier": "mm:longshot",
			"render_controllers": [
				"controller.render.item_default"
			],
			"materials": {
				"default": "entity_alphatest",
				"enchanted": "entity_alphatest_glint"
			},
			"textures": {
				"default": "textures/attachables/attachable_longshot",
				"enchanted": "textures/misc/enchanted_item_glint"
			},
			"geometry": {
				"default": "geometry.longshot"
			},
			"animations": {
				"first_person_hold": "animation.longshot.first_person_hold",
				"third_person_hold": "animation.longshot.third_person_hold",
				"catch_controller": "controller.animation.longshot.visible",
				"used": "animation.longshot.launch",
				"hide": "animation.longshot.hidden",
				"catch": "animation.longshot.reload"
			},
			"scripts": {
				"animate": [
					"catch_controller",
					{
						"first_person_hold": "c.is_first_person"
					},
					{
						"third_person_hold": "!c.is_first_person"
					}
				]
			}
		}
	}
}