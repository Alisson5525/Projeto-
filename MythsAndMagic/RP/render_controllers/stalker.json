{
    "format_version": "1.8.0",
    "render_controllers": {
        "controller.render.tangled": {
            "materials": [
                {
                    "*": "material.default"
                }
            ],
            "part_visibility": [
                {
                    "orb": "query.property('mm:mana') > 0"
                }
            ],
            "geometry": "geometry.default",
            "textures": [
                "texture.default"
            ]
        }
    }
}