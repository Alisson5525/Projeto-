{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "zenite:explosao",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/zenite"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 28
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.3,
        "direction": "outwards"
      },
      "minecraft:particle_initial_speed": "variable.tamanho * (2 + variable.particle_random_1 * 3)",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 2.5
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.5 + variable.particle_random_2 * 0.4"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.35 * (1 - (variable.particle_age / variable.particle_lifetime))",
          "0.35 * (1 - (variable.particle_age / variable.particle_lifetime))"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.lerp(1, variable.cor.r, math.min(1, (variable.particle_age / variable.particle_lifetime) * 3))",
          "math.lerp(1, variable.cor.g, math.min(1, (variable.particle_age / variable.particle_lifetime) * 3))",
          "math.lerp(1, variable.cor.b, math.min(1, (variable.particle_age / variable.particle_lifetime) * 3))",
          "variable.cor.a * (1 - (variable.particle_age / variable.particle_lifetime))"
        ]
      }
    }
  }
}
