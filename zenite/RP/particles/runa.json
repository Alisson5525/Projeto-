{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "zenite:runa",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/zenite"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_initial_spin": {
        "rotation": 0,
        "rotation_rate": 60
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 1.2
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "variable.tamanho",
          "variable.tamanho"
        ],
        "facing_camera_mode": "direction_z",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            32,
            32
          ],
          "uv_size": [
            32,
            32
          ]
        },
        "direction": {
          "mode": "custom",
          "custom_direction": [
            0,
            1,
            0
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.cor.r",
          "variable.cor.g",
          "variable.cor.b",
          "variable.cor.a * (math.sin((variable.particle_age / variable.particle_lifetime) * 180))"
        ]
      }
    }
  }
}
