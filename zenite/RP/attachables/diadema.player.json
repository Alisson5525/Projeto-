{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "zenite:diadema.player",
      "item": {
        "zenite:diadema": "query.owner_identifier == 'minecraft:player'"
      },
      "materials": {
        "default": "armor",
        "enchanted": "armor_enchanted"
      },
      "textures": {
        "default": "textures/models/armor/zenite_diadema",
        "enchanted": "textures/misc/enchanted_actor_glint"
      },
      "geometry": {
        "default": "geometry.zenite.diadema"
      },
      "scripts": {
        "parent_setup": "variable.helmet_layer_visible = 0.0;",
        "animate": [
          "offset",
          "aureola"
        ]
      },
      "animations": {
        "offset": "animation.armor.helmet.offset",
        "aureola": "animation.zenite.diadema.aureola"
      },
      "render_controllers": [
        "controller.render.armor"
      ]
    }
  }
}
