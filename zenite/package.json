{
  "name": "zenite-addon",
  "version": "1.0.0",
  "private": true,
  "description": "Zênite, o Feiticeiro do Firmamento — add-on para Minecraft Bedrock",
  "type": "module",
  "scripts": {
    "test": "node --import ./testes/mock/registrar.mjs --test \"testes/**/*.test.js\"",
    "typecheck": "tsc -p .",
