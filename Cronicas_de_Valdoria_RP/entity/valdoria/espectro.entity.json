        "look": "animation.valdoria.espectro.look",
        "attack": "animation.valdoria.espectro.attack",
        "drain": "animation.valdoria.espectro.drain"
      },
      "scripts": {
        "animate": [
          "float",
          "look",
          "attack",
          {
            "drain": "query.property('valdoria:anim') == 1"
          }
        ]
      },
      "render_controllers": [
        "controller.render.default"
      ],
      "spawn_egg": {
