{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "valdoria:cor_explosao",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/valdoria_particulas"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "8 + math.max(variable.radius, 0.5) * 10"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "offset": [
          0,
          0,
          0
        ],
        "radius": 0.2,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.3, 0.7)"
      },
      "minecraft:particle_initial_speed": "2 + math.max(variable.radius, 0.5)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0,
          0
        ],
        "linear_drag_coefficient": 3
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.18 + (0.0 - 0.18) * (variable.particle_age / variable.particle_lifetime)",
          "0.18 + (0.0 - 0.18) * (variable.particle_age / variable.particle_lifetime)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            16,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color.r",
          "variable.color.g",
          "variable.color.b",
          "1 - variable.particle_age / variable.particle_lifetime"
        ]
      }
    }
  }
}
