{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "valdoria:sangue_explosao",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/valdoria_particulas"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "12 + math.max(variable.radius, 0.5) * 8"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "offset": [
          0,
          0,
          0
        ],
        "radius": 0.3,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.4, 0.8)"
      },
      "minecraft:particle_initial_speed": "2.5 + math.max(variable.radius, 0.5)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -5,
          0
        ],
        "linear_drag_coefficient": 1.5
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.18 + (0.08 - 0.18) * (variable.particle_age / variable.particle_lifetime)",
          "0.18 + (0.08 - 0.18) * (variable.particle_age / variable.particle_lifetime)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            96,
            16
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": [
            [
              1.0,
              0.125,
              0.188,
              1.0
            ],
            [
              0.251,
              0.0,
              0.031,
              0.0
            ]
          ],
          "interpolant": "variable.particle_age / variable.particle_lifetime"
        }
      }
    }
  }
}
