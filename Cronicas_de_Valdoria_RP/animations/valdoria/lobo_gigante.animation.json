        "body": {
          "rotation": [
            "math.sin(query.modified_distance_moved * 60) * 3 * math.min(query.modified_move_speed, 1.0)",
            0,
            0
          ],
          "position": [
            0,
            "math.abs(math.sin(query.modified_distance_moved * 30)) * 1.0 * math.min(query.modified_move_speed, 1.0)",
            0
          ]
        },
        "neck": {
          "rotation": [
            "math.sin(query.modified_distance_moved * 60 + 40) * 5 * math.min(query.modified_move_speed, 1.0) + math.min(query.modified_move_speed, 1.0) * 10",
