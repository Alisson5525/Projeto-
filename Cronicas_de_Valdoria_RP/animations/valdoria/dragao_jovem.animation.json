      "loop": true,
      "bones": {
        "sela": {
          "scale": "query.is_tamed && !query.is_baby ? 1 : 0"
        },
        "head": {
          "scale": "query.is_baby ? 1.45 : 1"
        },
        "chifres": {
          "scale": "query.is_baby ? 0.4 : 1"
        }
      }
    },
    "animation.valdoria.dragao_jovem.sopro": {
      "loop": false,
      "bones": {
        "neck1": {
          "rotation": [
            10,
            0,
            0
          ]
        },
        "neck2": {
          "rotation": [
            8,
            0,
            0
          ]
        },
        "neck3": {
          "rotation": [
            6,
            0,
            0
          ]
        },
        "jaw": {
          "rotation": [
            "34 + math.sin(query.life_time * 900) * 3",
