          ]
        },
        "intro": {
          "animations": [
            "intro",
            "loadout"
          ],
          "blend_transition": 0.2,
          "transitions": [
            {
              "default": "query.property('valdoria:anim') != 10"
            }
          ]
        },
        "morte": {
          "animations": [
            "morte",
            "loadout"
          ],
          "blend_transition": 0.2,
          "transitions": [
            {
              "default": "query.property('valdoria:anim') != 11"
            }
          ]
        }
      }
    }
  }
}
