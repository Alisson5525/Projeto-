{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.valdoria.guardiao_celeste.main": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [
            "idle",
            {
              "walk": "query.modified_move_speed > 0.02"
            },
            "attack",
            "hurt"
          ],
          "transitions": [
            {
              "estocada": "query.property('valdoria:anim') == 1"
            },
            {
              "investida": "query.property('valdoria:anim') == 2"
            },
            {
              "lancas": "query.property('valdoria:anim') == 3"
            },
            {
              "rajada": "query.property('valdoria:anim') == 4"
            },
            {
              "chamado": "query.property('valdoria:anim') == 5"
            },
            {
              "juizo": "query.property('valdoria:anim') == 6"
            },
            {
              "intro": "query.property('valdoria:anim') == 7"
            },
            {
              "morte": "query.property('valdoria:anim') == 8"
            },
            {
              "ascensao": "query.property('valdoria:anim') == 9"
            }
          ],
          "blend_transition": 0.25
        },
        "estocada": {
          "animations": [
            "estocada"
          ],
          "blend_transition": 0.2,
          "transitions": [
            {
              "default": "query.property('valdoria:anim') != 1"
            }
          ]
        },
        "investida": {
          "animations": [
            "investida"
          ],
          "blend_transition": 0.2,
          "transitions": [
            {
              "default": "query.property('valdoria:anim') != 2"
            }
          ]
        },
        "lancas": {
          "animations": [
            "lancas"
          ],
          "blend_transition": 0.2,
          "transitions": [
            {
              "default": "query.property('valdoria:anim') != 3"
            }
          ]
        },
        "rajada": {
          "animations": [
            "rajada"
          ],
          "blend_transition": 0.2,
          "transitions": [
            {
              "default": "query.property('valdoria:anim') != 4"
            }
          ]
        },
        "chamado": {
          "animations": [
            "chamado"
          ],
          "blend_transition": 0.2,
          "transitions": [
            {
              "default": "query.property('valdoria:anim') != 5"
            }
          ]
        },
        "juizo": {
          "animations": [
            "juizo"
          ],
          "blend_transition": 0.2,
          "transitions": [
            {
              "default": "query.property('valdoria:anim') != 6"
            }
          ]
        },
        "intro": {
          "animations": [
            "intro"
          ],
          "blend_transition": 0.2,
          "transitions": [
            {
              "default": "query.property('valdoria:anim') != 7"
            }
          ]
        },
        "morte": {
          "animations": [
            "morte"
          ],
          "blend_transition": 0.2,
          "transitions": [
            {
              "default": "query.property('valdoria:anim') != 8"
            }
          ]
        },
        "ascensao": {
          "animations": [
            "ascensao"
          ],
          "blend_transition": 0.2,
          "transitions": [
            {
              "default": "query.property('valdoria:anim') != 9"
            }
          ]
        }
      }
    }
  }
}
