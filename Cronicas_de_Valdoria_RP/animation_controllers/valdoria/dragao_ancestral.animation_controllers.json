          ]
        },
        "voo": {
          "animations": [
            "voo"
          ],
          "blend_transition": 0.25,
          "transitions": [
            {
              "default": "query.property('valdoria:anim') != 6"
            }
          ]
        },
        "pousar": {
          "animations": [
            "pousar"
          ],
          "blend_transition": 0.25,
          "transitions": [
            {
              "default": "query.property('valdoria:anim') != 7"
            }
          ]
        },
        "rasante": {
          "animations": [
            "rasante"
          ],
          "blend_transition": 0.25,
          "transitions": [
            {
              "default": "query.property('valdoria:anim') != 8"
            }
          ]
        },
        "exausto": {
          "animations": [
            "exausto"
          ],
          "blend_transition": 0.25,
          "transitions": [
            {
              "default": "query.property('valdoria:anim') != 9"
            }
          ]
        },
        "meteoros": {
          "animations": [
            "meteoros"
          ],
          "blend_transition": 0.25,
          "transitions": [
            {
              "default": "query.property('valdoria:anim') != 10"
            }
          ]
        },
        "morte": {
          "animations": [
            "morte"
          ],
          "blend_transition": 0.25,
          "transitions": [
            {
              "default": "query.property('valdoria:anim') != 11"
            }
          ]
        },
        "intro": {
          "animations": [
            "intro"
          ],
          "blend_transition": 0.25,
          "transitions": [
            {
              "default": "query.property('valdoria:anim') != 12"
            }
          ]
        },
        "voo_fogo": {
          "animations": [
            "voo_fogo"
          ],
          "blend_transition": 0.25,
